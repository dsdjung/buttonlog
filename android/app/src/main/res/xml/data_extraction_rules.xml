<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; see https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for more information.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- User preferences and settings should be backed up -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude sensitive data -->
        <exclude domain="database" path="buttonlog.db"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="database" path="buttonlog.db"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>

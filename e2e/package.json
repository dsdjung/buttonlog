{
  "name": "buttonlog-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for ButtonLog",
  "scripts": {
    "test": "TEST_ENV=local playwright test --project=chromium",
    "test:all": "TEST_ENV=local playwright test",
    "test:local": "TEST_ENV=local playwright test --project=chromium",
    "test:staging": "TEST_ENV=staging playwright test --project=chromium",
    "test:prod": "TEST_ENV=production playwright test --project=chromium",
    "test:ui": "TEST_ENV=local playwright test --ui",
    "test:headed": "TEST_ENV=local playwright test --headed --project=chromium",
    "test:debug": "TEST_ENV=local playwright test --debug --project=chromium",
    "test:chromium": "TEST_ENV=local playwright test --project=chromium",
    "test:firefox": "TEST_ENV=local playwright test --project=firefox",
    "test:webkit": "TEST_ENV=local playwright test --project=webkit",
    "test:mobile": "TEST_ENV=local playwright test --project=mobile-chrome --project=mobile-safari",
    "test:setup": "TEST_ENV=local playwright test --project=setup --headed",
    "test:auth": "TEST_ENV=local playwright test --project=chromium-auth",
    "test:auth:headed": "TEST_ENV=local playwright test --project=chromium-auth --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:14015",
    "codegen:auth": "playwright codegen http://localhost:14015 --save-storage=playwright/.auth/user.json",
    "codegen:staging": "playwright codegen",
    "install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}

# iOS Fastlane Configuration
# This file configures automated deployment to App Store Connect

default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "ButtonLog",
      device: "iPhone 15"
    )
  end

  desc "Build for development"
  lane :build_debug do
    build_app(
      scheme: "ButtonLog",
      configuration: "Debug",
      export_method: "development",
      skip_archive: true
    )
  end

  desc "Build release for App Store"
  lane :build_release do
    # Ensure we have the latest certificates and profiles
    sync_code_signing(type: "appstore")

    # Increment build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || (Time.now.to_i / 60).to_s
    )

    # Set version if provided
    if ENV["VERSION_NUMBER"]
      increment_version_number(
        version_number: ENV["VERSION_NUMBER"]
      )
    end

    build_app(
      scheme: "ButtonLog",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ButtonLog.ipa"
    )
  end

  desc "Deploy to TestFlight (internal testing)"
  lane :deploy_testflight do
    build_release

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Deploy to TestFlight with external testers"
  lane :deploy_beta do
    build_release

    upload_to_testflight(
      distribute_external: true,
      groups: ["Beta Testers"],
      changelog: ENV["CHANGELOG"] || "Bug fixes and improvements"
    )
  end

  desc "Deploy to App Store"
  lane :deploy_production do
    build_release

    upload_to_app_store(
      submit_for_review: false,  # Manual review submission
      automatic_release: false,
      phased_release: true
    )
  end

  desc "Submit for App Store review"
  lane :submit_for_review do
    upload_to_app_store(
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # Code Signing with match
  desc "Sync development certificates"
  lane :sync_dev_certs do
    sync_code_signing(type: "development")
  end

  desc "Sync App Store certificates"
  lane :sync_appstore_certs do
    sync_code_signing(type: "appstore")
  end

  desc "Register new devices"
  lane :register_devices do
    register_devices(devices_file: "./fastlane/devices.txt")
    sync_code_signing(type: "development", force_for_new_devices: true)
  end
end

<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Choose Your Plan</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Start free and upgrade when you need more power. All plans include core button tracking features.
      </p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-8">
      <div class="bg-white rounded-lg p-1 shadow-sm border border-gray-200 inline-flex">
        <button
          phx-click="toggle_billing_cycle"
          class={"px-6 py-2 rounded-md text-sm font-medium transition-colors #{if @billing_cycle == :monthly, do: "bg-teal-600 text-white", else: "text-gray-700 hover:text-gray-900"}"}
        >
          Monthly
        </button>
        <button
          phx-click="toggle_billing_cycle"
          class={"px-6 py-2 rounded-md text-sm font-medium transition-colors #{if @billing_cycle == :yearly, do: "bg-teal-600 text-white", else: "text-gray-700 hover:text-gray-900"}"}
        >
          Yearly <span class="text-xs text-green-600 font-normal">(Save 17%)</span>
        </button>
      </div>
    </div>

    <!-- Pricing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <%= for plan <- @plans do %>
        <div class={"bg-white rounded-2xl shadow-lg border-2 overflow-hidden #{if plan.slug == "premium", do: "border-teal-500 relative", else: "border-gray-200"}"}>
          <%= if plan.slug == "premium" do %>
            <div class="bg-teal-500 text-white text-center py-1 text-sm font-medium">
              Most Popular
            </div>
          <% end %>

          <div class="p-6">
            <!-- Plan Header -->
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900"><%= plan.name %></h2>
              <p class="text-gray-500 text-sm mt-1"><%= plan.description %></p>
            </div>

            <!-- Price -->
            <div class="text-center mb-6">
              <%= if plan.slug == "free" do %>
                <div class="text-4xl font-bold text-gray-900">$0</div>
                <div class="text-gray-500 text-sm">Forever free</div>
              <% else %>
                <div class="text-4xl font-bold text-gray-900">
                  $<%= if @billing_cycle == :monthly, do: Decimal.to_string(plan.price_monthly), else: Decimal.to_string(Decimal.div(plan.price_yearly, 12) |> Decimal.round(2)) %>
                </div>
                <div class="text-gray-500 text-sm">
                  per month<%= if @billing_cycle == :yearly, do: ", billed yearly" %>
                </div>
                <%= if @billing_cycle == :yearly do %>
                  <div class="text-green-600 text-sm mt-1">
                    $<%= Decimal.to_string(plan.price_yearly) %>/year
                  </div>
                <% end %>
              <% end %>
            </div>

            <!-- Current Plan Indicator -->
            <%= if @current_plan_slug == plan.slug do %>
              <div class="mb-6">
                <div class="bg-teal-50 border border-teal-200 rounded-lg py-2 text-center text-teal-700 font-medium">
                  Current Plan
                </div>
              </div>
            <% else %>
              <div class="mb-6">
                <%= if plan.slug == "free" do %>
                  <div class="py-2 text-center text-gray-400 text-sm">
                    Basic features
                  </div>
                <% else %>
                  <button
                    phx-click="select_plan"
                    phx-value-plan_id={plan.id}
                    class={"w-full py-3 rounded-lg font-medium transition-colors #{if plan.slug == "premium", do: "bg-teal-600 text-white hover:bg-teal-700", else: "bg-gray-800 text-white hover:bg-gray-900"}"}
                  >
                    <%= if plan.trial_days > 0, do: "Start #{plan.trial_days}-Day Free Trial", else: "Get Started" %>
                  </button>
                <% end %>
              </div>
            <% end %>

            <!-- Features -->
            <div class="space-y-3">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">
                  <%= if plan.max_buttons == -1, do: "Unlimited buttons", else: "#{plan.max_buttons} buttons" %>
                </span>
              </div>
              <div class="flex items-center">
                <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">
                  <%= if plan.max_friends == -1, do: "Unlimited friends", else: "#{plan.max_friends} friends" %>
                </span>
              </div>
              <div class="flex items-center">
                <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">
                  <%= if plan.max_button_clicks_per_month == -1, do: "Unlimited clicks", else: "#{plan.max_button_clicks_per_month} clicks/month" %>
                </span>
              </div>
              <div class="flex items-center">
                <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">
                  <%= if plan.max_analytics_history_days == -1, do: "Unlimited history", else: "#{plan.max_analytics_history_days} days history" %>
                </span>
              </div>

              <%= if plan.has_advanced_analytics do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">Advanced analytics</span>
                </div>
              <% end %>

              <%= if plan.has_calendar_sync do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">Calendar sync</span>
                </div>
              <% end %>

              <%= if plan.has_api_access do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">API access</span>
                </div>
              <% end %>

              <%= if plan.has_custom_themes do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">Custom themes</span>
                </div>
              <% end %>

              <%= if plan.has_priority_support do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">Priority support</span>
                </div>
              <% end %>

              <%= if plan.has_team_features do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">Team features</span>
                </div>
              <% end %>

              <%= if plan.has_white_label do %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-teal-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">White-label options</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Can I cancel anytime?</h3>
          <p class="text-gray-600">Yes, you can cancel your subscription at any time. You'll continue to have access until the end of your billing period.</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">What happens if I exceed my limits?</h3>
          <p class="text-gray-600">We'll notify you when you're approaching your limits. You can upgrade anytime to get more capacity.</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Is there a free trial?</h3>
          <p class="text-gray-600">Yes! Premium plans come with a 14-day free trial, and Enterprise plans have a 30-day trial.</p>
        </div>
      </div>
    </div>

    <!-- Back Link -->
    <div class="text-center mt-12">
      <a href={~p"/"} class="inline-flex items-center text-teal-600 hover:text-teal-700 font-medium">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Buttons
      </a>
    </div>
  </div>
</div>

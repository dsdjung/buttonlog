<div class="min-h-screen bg-gray-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <%= if @current_user do %>
        <!-- Diary Header -->
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Diary</h1>
            <p class="text-gray-600 mt-2">Track your daily button activities and progress</p>
          </div>

          <!-- Date Navigation -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-gray-900">Date Selection</h2>
              <button phx-click="go_to_today" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors text-sm">
                Go to Today
              </button>
            </div>
            
            <div class="flex items-center justify-center space-x-4">
              <button phx-click="previous_day" class="p-2 text-gray-600 hover:text-primary transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              
              <div class="text-center">
                <h3 class="text-2xl font-bold text-gray-900">
                  <%= get_relative_date_text(@selected_date) %>
                </h3>
                <p class="text-gray-600">
                  <%= Calendar.strftime(@selected_date, "%A, %B %d, %Y") %>
                </p>
              </div>
              
              <button phx-click="next_day" class="p-2 text-gray-600 hover:text-primary transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>

            <!-- Calendar Input -->
            <div class="mt-4 text-center">
              <input type="date" 
                     id="diary-date-input"
                     name="date"
                     value={Date.to_string(@selected_date)}
                     phx-hook="DateSelector"
                     class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                     max={Date.to_string(get_local_today())}>
              <div class="text-sm text-gray-500 mt-2">
                Select a date to view activities
              </div>
            </div>
          </div>

          <!-- Daily Summary -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Daily Summary</h2>
            
            <%= if @summary.is_empty do %>
              <div class="text-center py-8">
                <div class="text-gray-400 mb-4">
                  <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No activities yet</h3>
                <p class="text-gray-500">You haven't used any buttons on this date</p>
              </div>
            <% else %>
              <!-- Daily Activities Summary -->
              <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                <h4 class="font-medium text-blue-900 mb-3">Today's Activities</h4>
                <div class="space-y-2">
                  <%= for activity_text <- @summary.formatted_activities do %>
                    <div class="text-blue-800 text-sm">
                      • <%= activity_text %>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Total Active Time Summary -->
              <%= if @summary.total_active_time > 0 do %>
                <div class="mt-4 p-4 bg-purple-50 rounded-lg border border-purple-200">
                  <h4 class="font-medium text-purple-900 mb-2">⏱️ Total Active Time Today</h4>
                  <div class="text-purple-800 text-lg font-semibold">
                    <%= format_duration(@summary.total_active_time) %>
                  </div>
                  <div class="text-purple-600 text-sm mt-1">
                    Combined active time from all toggle buttons
                  </div>
                </div>
              <% end %>

              <!-- In-Progress Timed Buttons -->
              <%= if length(@summary.in_progress_toggle_buttons) > 0 do %>
                <div class="mt-4 p-4 bg-green-50 rounded-lg border border-green-200">
                  <div class="flex items-center justify-between mb-3">
                    <h4 class="font-medium text-green-900">⏱️ Currently In Progress</h4>
                    <button phx-click="refresh_in_progress" class="text-green-600 hover:text-green-800 text-sm font-medium">
                      🔄 Refresh
                    </button>
                  </div>
                  <div class="space-y-3">
                    <%= for in_progress <- @summary.in_progress_toggle_buttons do %>
                      <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-green-200">
                        <div class="flex items-center space-x-3">
                          <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-lg font-bold" 
                               style={"background-color: #{in_progress.button.color}"}>
                            <%= in_progress.button.icon %>
                          </div>
                          <div>
                            <div class="font-medium text-green-900"><%= in_progress.button.name %></div>
                            <div class="text-sm text-green-700">
                              Started <%= format_relative_time(in_progress.start_time) %> ago
                            </div>
                          </div>
                        </div>
                        <div class="text-right">
                          <div class="text-lg font-bold text-green-900">
                            <%= format_duration(in_progress.duration_so_far) %>
                          </div>
                          <div class="text-xs text-green-600">
                            <%= in_progress.total_clicks %> clicks today
                            <%= if in_progress.total_duration_today > 0 do %>
                              <br>Total active: <%= format_duration(in_progress.total_duration_today) %>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>

          <!-- Daily Activities -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Daily Activities</h2>
            
            <%= if @summary.is_empty do %>
              <div class="text-center py-8 text-gray-500">
                <p>No button activities recorded for this date.</p>
                <p class="text-sm mt-2">Try clicking some buttons to see them appear here!</p>
              </div>
            <% else %>
              <div class="space-y-4">
                <%= for activity <- @activities do %>
                  <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center justify-between mb-3">
                      <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-full flex items-center justify-center text-white text-xl font-bold" 
                             style={"background-color: #{activity.button.color}"}>
                          <%= activity.button.icon %>
                        </div>
                        <div>
                          <h3 class="text-lg font-semibold text-gray-900"><%= activity.button.name %></h3>
                          <div class="flex items-center space-x-2 text-sm text-gray-600">
                            <span class="capitalize"><%= activity.button.type %></span>
                            <span>•</span>
                            <%= if activity.button.type == "toggle" do %>
                              <span><%= count_active_sessions(activity.clicks) %> sessions</span>
                              <span>•</span>
                              <span><%= activity.total_clicks %> clicks</span>
                            <% else %>
                              <span><%= activity.total_clicks %> clicks</span>
                            <% end %>
                          </div>
                        </div>
                      </div>
                      
                      <div class="text-right text-sm text-gray-500">
                        <div>First: <%= Calendar.strftime(activity.first_click, "%I:%M %p") %></div>
                        <div>Last: <%= Calendar.strftime(activity.last_click, "%I:%M %p") %></div>
                      </div>
                    </div>
                    
                    <!-- Click Timeline -->
                    <div class="mt-3 pt-3 border-t border-gray-100">
                      <h4 class="text-sm font-medium text-gray-700 mb-2">Click Timeline</h4>
                      <div class="flex flex-wrap gap-2">
                        <%= for click <- Enum.take(activity.clicks, 10) do %>
                          <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                            <%= Calendar.strftime(click.clicked_at, "%I:%M %p") %>
                          </span>
                        <% end %>
                        <%= if length(activity.clicks) > 10 do %>
                          <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-600">
                            +<%= length(activity.clicks) - 10 %> more
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Authentication Required</h3>
          <p class="text-gray-500 mb-4">Please log in to view your diary</p>
          <a href={~p"/auth/login"} class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors">
            Log In
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

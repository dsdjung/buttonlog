<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Friends</h1>
          <p class="text-gray-600">Manage your friends and friend requests</p>
        </div>
        <a href={~p"/buttons"} class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors">
          Back to Buttons
        </a>
      </div>

      <!-- Flash Messages -->
      <%= if @flash[:info] do %>
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
          <%= @flash[:info] %>
        </div>
      <% end %>
      
      <%= if @flash[:error] do %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
          <%= @flash[:error] %>
        </div>
      <% end %>

      <!-- Search Users -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Find Friends</h2>
        <form phx-change="search_users" class="flex gap-4">
          <input type="text" name="query" value={@search_query} 
                 placeholder="Search by username or display name..."
                 class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                 minlength="3">
          <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-600 transition-colors">
            Search
          </button>
        </form>

        <!-- Search Results -->
        <%= if length(@search_results) > 0 do %>
          <div class="mt-6">
            <h3 class="text-md font-medium text-gray-900 mb-3">Search Results</h3>
            <div class="space-y-3">
              <%= for user <- @search_results do %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <%= if user.avatar do %>
                      <img src={user.avatar} alt="Avatar" class="w-10 h-10 rounded-full">
                    <% else %>
                      <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                        <span class="text-gray-600 font-medium"><%= String.first(user.username) %></span>
                      </div>
                    <% end %>
                    <div>
                      <p class="font-medium text-gray-900"><%= user.display_name %></p>
                      <p class="text-sm text-gray-500">@<%= user.username %></p>
                    </div>
                  </div>
                  <button phx-click="send_friend_request" phx-value-user_id={user.id}
                          class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
                    Send Request
                  </button>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pending Friend Requests -->
      <%= if length(@pending_requests) > 0 do %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Pending Friend Requests</h2>
          <div class="space-y-4">
            <%= for request <- @pending_requests do %>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div class="flex items-center space-x-3">
                  <%= if request.user.avatar do %>
                    <img src={request.user.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(request.user.username) %></span>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-gray-900"><%= request.user.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= request.user.username %></p>
                    <p class="text-xs text-gray-400">Requested <%= Calendar.strftime(request.inserted_at, "%B %d, %Y") %></p>
                  </div>
                </div>
                <div class="flex space-x-2">
                  <button phx-click="accept_friend_request" phx-value-friendship_id={request.id}
                          class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
                    Accept
                  </button>
                  <button phx-click="decline_friend_request" phx-value-friendship_id={request.id}
                          class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
                    Decline
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Sent Friend Requests -->
      <%= if length(@sent_requests) > 0 do %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Sent Friend Requests</h2>
          <div class="space-y-4">
            <%= for request <- @sent_requests do %>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div class="flex items-center space-x-3">
                  <%= if request.friend.avatar do %>
                    <img src={request.friend.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(request.friend.username) %></span>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-gray-900"><%= request.friend.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= request.friend.username %></p>
                    <p class="text-xs text-gray-400">Sent <%= Calendar.strftime(request.inserted_at, "%B %d, %Y") %></p>
                  </div>
                </div>
                <button phx-click="cancel_friend_request" phx-value-friendship_id={request.id}
                        class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Created Gift Buttons -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <button
          phx-click="toggle_gift_buttons"
          class="flex items-center justify-between w-full text-left"
        >
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Buttons I Created for Friends</h2>
              <p class="text-sm text-gray-500">Manage gift buttons you've created (<%= length(@created_gift_buttons) %>)</p>
            </div>
          </div>
          <svg class={"w-5 h-5 text-gray-400 transform transition-transform #{if @show_gift_buttons, do: "rotate-180", else: ""}"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <%= if @show_gift_buttons do %>
          <div class="mt-6 space-y-4">
            <%= if length(@created_gift_buttons) > 0 do %>
              <%= for button <- @created_gift_buttons do %>
                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors">
                  <div class="flex items-center space-x-3">
                    <div class={"w-10 h-10 rounded-full flex items-center justify-center text-white"} style={"background-color: #{button.color || "#6366F1"}"}>
                      <span class="text-lg"><%= button.icon || "⭐" %></span>
                    </div>
                    <div>
                      <p class="font-medium text-gray-900"><%= button.name %></p>
                      <%= if button.description do %>
                        <p class="text-sm text-gray-500"><%= button.description %></p>
                      <% end %>
                      <div class="flex items-center space-x-2 mt-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                          <%= button.type %>
                        </span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                          </svg>
                          For <%= button.recipient.display_name || button.recipient.username || "Friend" %>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="flex space-x-2">
                    <button
                      phx-click="edit_gift_button"
                      phx-value-button_id={button.id}
                      class="p-2 text-gray-500 hover:text-primary hover:bg-gray-100 rounded-lg transition-colors"
                      title="Edit"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </button>
                    <button
                      phx-click="delete_gift_button"
                      phx-value-button_id={button.id}
                      data-confirm="Are you sure you want to delete this gift button? This will also remove it from your friend's buttons."
                      class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                      title="Delete"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-8">
                <div class="text-gray-400 mb-4">
                  <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No gift buttons yet</h3>
                <p class="text-gray-500">When you create buttons for your friends, they'll appear here.</p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Edit Gift Button Modal -->
      <%= if @editing_gift_button do %>
        <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" phx-click="cancel_edit_gift_button">
          <div class="relative top-20 mx-auto p-5 border w-full max-w-md shadow-lg rounded-lg bg-white" phx-click-away="cancel_edit_gift_button">
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-gray-900">Edit Gift Button</h3>
              <p class="text-sm text-gray-500">For <%= @editing_gift_button.recipient.display_name || @editing_gift_button.recipient.username %></p>
            </div>

            <.form for={%{}} phx-submit="save_gift_button" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                <input type="text" name="button[name]" value={@editing_gift_button.name} required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description (optional)</label>
                <textarea name="button[description]" rows="2"
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"><%= @editing_gift_button.description %></textarea>
              </div>

              <!-- Icon Selection -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Icon</label>
                <div class="grid grid-cols-5 gap-2">
                  <%= for icon <- ["⭐", "❤️", "⚡", "🔥", "🍀", "💧", "☀️", "🌙", "☁️", "❄️", "🚗", "✈️", "🎮", "📚", "✏️", "✂️", "🔧", "🔨", "⚙️", "🔒"] do %>
                    <label class="cursor-pointer">
                      <input type="radio" name="button[icon]" value={icon} class="sr-only peer" checked={(@editing_gift_button.icon || "⭐") == icon}>
                      <div class="w-10 h-10 flex items-center justify-center text-xl rounded-lg border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/10 hover:border-gray-300 transition-colors">
                        <%= icon %>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>

              <!-- Color Selection -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Color</label>
                <div class="grid grid-cols-5 gap-2">
                  <%= for color <- ["#FF6B6B", "#4ECDC4", "#45B7D1", "#96CEB4", "#FFEAA7", "#DDA0DD", "#98D8C8", "#F7DC6F", "#BB8FCE", "#85C1E9", "#F8B500", "#00CED1", "#FF69B4", "#32CD32", "#FF7F50", "#9370DB", "#20B2AA", "#FFD700", "#DC143C", "#4169E1"] do %>
                    <label class="cursor-pointer">
                      <input type="radio" name="button[color]" value={color} class="sr-only peer" checked={(@editing_gift_button.color || "#6366F1") == color}>
                      <div class="w-10 h-10 rounded-lg border-2 border-transparent peer-checked:border-gray-800 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-primary hover:opacity-80 transition-all" style={"background-color: #{color}"}></div>
                    </label>
                  <% end %>
                </div>
              </div>

              <!-- Choices (for one-time buttons) -->
              <%= if @editing_gift_button.type == "one-time" do %>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Choices (Optional)</label>
                  <div class="space-y-2" id="choices-container" phx-hook="ChoicesEditor">
                    <%= for {choice, index} <- Enum.with_index(@editing_gift_button.choices || []) do %>
                      <div class="flex items-center space-x-2">
                        <input type="text" name="button[choices][]" value={choice}
                               placeholder={"Choice #{index + 1}"}
                               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm">
                        <button type="button" onclick="this.parentElement.remove()"
                                class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                        </button>
                      </div>
                    <% end %>
                  </div>
                  <button type="button" onclick="addChoice()" class="mt-2 flex items-center text-sm text-primary hover:text-primary-600 transition-colors">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Choice
                  </button>
                  <script>
                    function addChoice() {
                      const container = document.getElementById('choices-container');
                      const count = container.querySelectorAll('input[name="button[choices][]"]').length;
                      if (count >= 4) return;
                      const div = document.createElement('div');
                      div.className = 'flex items-center space-x-2';
                      div.innerHTML = `
                        <input type="text" name="button[choices][]" placeholder="Choice ${count + 1}"
                               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm">
                        <button type="button" onclick="this.parentElement.remove()"
                                class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                        </button>
                      `;
                      container.appendChild(div);
                    }
                  </script>
                </div>
              <% end %>

              <div class="flex justify-end space-x-3 pt-4">
                <button type="button" phx-click="cancel_edit_gift_button"
                        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                  Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors">
                  Save Changes
                </button>
              </div>
            </.form>
          </div>
        </div>
      <% end %>

      <!-- Current Friends -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Your Friends</h2>
                <%= if length(@friends) > 0 do %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%= for friend <- @friends do %>
              <a href={~p"/friends/#{friend.id}"} class="block p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:shadow-md transition-all duration-200">
                <div class="flex items-center space-x-3">
                  <%= if friend.avatar do %>
                    <img src={friend.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(friend.username) %></span>
                    </div>
                  <% end %>
                  <div class="flex-1">
                    <p class="font-medium text-gray-900"><%= friend.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= friend.username %></p>
                  </div>
                  <div class="text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </div>
              </a>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="text-gray-400 mb-4">
              <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No friends yet</h3>
            <p class="text-gray-500">Search for users above to send friend requests</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Friends</h1>
          <p class="text-gray-600">Manage your friends and friend requests</p>
        </div>
        <a href={~p"/buttons"} class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors">
          Back to Buttons
        </a>
      </div>

      <!-- Flash Messages -->
      <%= if @flash[:info] do %>
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
          <%= @flash[:info] %>
        </div>
      <% end %>
      
      <%= if @flash[:error] do %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
          <%= @flash[:error] %>
        </div>
      <% end %>

      <!-- Search Users -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Find Friends</h2>
        <form phx-change="search_users" class="flex gap-4">
          <input type="text" name="query" value={@search_query} 
                 placeholder="Search by username or display name..."
                 class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                 minlength="3">
          <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-600 transition-colors">
            Search
          </button>
        </form>

        <!-- Search Results -->
        <%= if length(@search_results) > 0 do %>
          <div class="mt-6">
            <h3 class="text-md font-medium text-gray-900 mb-3">Search Results</h3>
            <div class="space-y-3">
              <%= for user <- @search_results do %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <%= if user.avatar do %>
                      <img src={user.avatar} alt="Avatar" class="w-10 h-10 rounded-full">
                    <% else %>
                      <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                        <span class="text-gray-600 font-medium"><%= String.first(user.username) %></span>
                      </div>
                    <% end %>
                    <div>
                      <p class="font-medium text-gray-900"><%= user.display_name %></p>
                      <p class="text-sm text-gray-500">@<%= user.username %></p>
                    </div>
                  </div>
                  <button phx-click="send_friend_request" phx-value-user_id={user.id}
                          class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
                    Send Request
                  </button>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pending Friend Requests -->
      <%= if length(@pending_requests) > 0 do %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Pending Friend Requests</h2>
          <div class="space-y-4">
            <%= for request <- @pending_requests do %>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div class="flex items-center space-x-3">
                  <%= if request.user.avatar do %>
                    <img src={request.user.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(request.user.username) %></span>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-gray-900"><%= request.user.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= request.user.username %></p>
                    <p class="text-xs text-gray-400">Requested <%= Calendar.strftime(request.inserted_at, "%B %d, %Y") %></p>
                  </div>
                </div>
                <div class="flex space-x-2">
                  <button phx-click="accept_friend_request" phx-value-friendship_id={request.id}
                          class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
                    Accept
                  </button>
                  <button phx-click="decline_friend_request" phx-value-friendship_id={request.id}
                          class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
                    Decline
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Sent Friend Requests -->
      <%= if length(@sent_requests) > 0 do %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Sent Friend Requests</h2>
          <div class="space-y-4">
            <%= for request <- @sent_requests do %>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div class="flex items-center space-x-3">
                  <%= if request.friend.avatar do %>
                    <img src={request.friend.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(request.friend.username) %></span>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-gray-900"><%= request.friend.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= request.friend.username %></p>
                    <p class="text-xs text-gray-400">Sent <%= Calendar.strftime(request.inserted_at, "%B %d, %Y") %></p>
                  </div>
                </div>
                <button phx-click="cancel_friend_request" phx-value-friendship_id={request.id}
                        class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Current Friends -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Your Friends</h2>
                <%= if length(@friends) > 0 do %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%= for friend <- @friends do %>
              <a href={~p"/friends/#{friend.id}"} class="block p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:shadow-md transition-all duration-200">
                <div class="flex items-center space-x-3">
                  <%= if friend.avatar do %>
                    <img src={friend.avatar} alt="Avatar" class="w-12 h-12 rounded-full">
                  <% else %>
                    <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 font-medium"><%= String.first(friend.username) %></span>
                    </div>
                  <% end %>
                  <div class="flex-1">
                    <p class="font-medium text-gray-900"><%= friend.display_name %></p>
                    <p class="text-sm text-gray-500">@<%= friend.username %></p>
                  </div>
                  <div class="text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </div>
              </a>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="text-gray-400 mb-4">
              <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No friends yet</h3>
            <p class="text-gray-500">Search for users above to send friend requests</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

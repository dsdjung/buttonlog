<div class="min-h-screen bg-gray-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <%= if @current_user do %>
        <!-- Account Header -->
        <div class="max-w-4xl mx-auto">
          <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Account Settings</h1>
            <p class="text-gray-600 mt-2">Manage your account and preferences</p>
          </div>

          <!-- User Profile Section -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-xl font-semibold text-gray-900">Profile Information</h2>
              <%= if !@editing_profile do %>
                <button
                  phx-click="start_edit_profile"
                  class="px-4 py-2 text-sm font-medium rounded-lg transition-colors"
                  style="background-color: #0d9488; color: white;"
                >
                  Edit Profile
                </button>
              <% end %>
            </div>

            <%= if @editing_profile do %>
              <!-- Edit Profile Form -->
              <form phx-submit="save_profile" phx-change="validate_profile" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="display_name" class="block text-sm font-medium text-gray-700 mb-1">Display Name</label>
                    <input
                      type="text"
                      name="profile[display_name]"
                      id="display_name"
                      value={@profile_form["display_name"]}
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                      placeholder="Your display name"
                    />
                  </div>
                  <div>
                    <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                    <input
                      type="text"
                      name="profile[first_name]"
                      id="first_name"
                      value={@profile_form["first_name"]}
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                      placeholder="First name"
                    />
                  </div>
                  <div>
                    <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                    <input
                      type="text"
                      name="profile[last_name]"
                      id="last_name"
                      value={@profile_form["last_name"]}
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                      placeholder="Last name"
                    />
                  </div>
                </div>

                <!-- Read-only fields -->
                <div class="mt-4 p-4 bg-gray-50 rounded-lg">
                  <p class="text-sm text-gray-500 mb-3">The following fields cannot be changed here:</p>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-sm font-medium text-gray-500 mb-1">Email</label>
                      <p class="text-gray-700"><%= @current_user.email %></p>
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-gray-500 mb-1">Username</label>
                      <p class="text-gray-700"><%= @current_user.username %></p>
                    </div>
                  </div>
                </div>

                <div class="flex gap-3 mt-4">
                  <button
                    type="submit"
                    class="px-4 py-2 text-sm font-medium rounded-lg transition-colors"
                    style="background-color: #0d9488; color: white;"
                  >
                    Save Changes
                  </button>
                  <button
                    type="button"
                    phx-click="cancel_edit_profile"
                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            <% else %>
              <!-- View Mode -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                  <p class="text-gray-900 font-medium"><%= @current_user.username %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Display Name</label>
                  <p class="text-gray-900 font-medium"><%= @current_user.display_name || "-" %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                  <p class="text-gray-900 font-medium"><%= @current_user.first_name || "-" %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                  <p class="text-gray-900 font-medium"><%= @current_user.last_name || "-" %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                  <p class="text-gray-900 font-medium"><%= @current_user.email %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Member Since</label>
                  <p class="text-gray-900 font-medium">
                    <%= Calendar.strftime(@current_user.inserted_at, "%B %d, %Y") %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Subscription Section -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Subscription</h2>

            <%= if @subscription_info do %>
              <%
                # Safely get the subscription - may be nil for free users
                subscription = Map.get(@subscription_info, :subscription)
                usage = Map.get(@subscription_info, :usage, %{})
              %>
              <div class="mb-6">
                <!-- Current Plan -->
                <div class="flex items-center justify-between p-4 bg-gradient-to-r from-primary-50 to-primary-100 rounded-lg border border-primary-200 mb-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-lg font-medium text-primary-900"><%= @subscription_info.plan.name %> Plan</h3>
                      <%= if subscription && subscription.status == "active" do %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Active
                        </span>
                      <% end %>
                      <%= if subscription && subscription.status == "trialing" do %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                          Trial
                        </span>
                      <% end %>
                    </div>
                    <p class="text-primary-700 text-sm mt-1"><%= @subscription_info.plan.description %></p>
                    <%= if subscription && subscription.current_period_end do %>
                      <p class="text-primary-600 text-xs mt-2">
                        Next billing: <%= Calendar.strftime(subscription.current_period_end, "%B %d, %Y") %>
                      </p>
                    <% end %>
                  </div>
                  <div class="text-right">
                    <%= if @subscription_info.plan.slug != "free" && subscription do %>
                      <div class="text-2xl font-bold text-primary-900">
                        $<%= Decimal.to_string(subscription.amount) %>
                      </div>
                      <div class="text-sm text-primary-600">/<%= subscription.billing_cycle %></div>
                    <% else %>
                      <div class="text-2xl font-bold text-primary-900">Free</div>
                    <% end %>
                  </div>
                </div>

                <!-- Trial Countdown Banner -->
                <%= if subscription && subscription.status == "trialing" && subscription.trial_end do %>
                  <%
                    days_remaining = max(0, Date.diff(subscription.trial_end, Date.utc_today()))
                    day_text = if days_remaining == 1, do: "day", else: "days"
                  %>
                  <div class="flex items-center p-4 bg-amber-50 rounded-lg border border-amber-200 mb-4">
                    <svg class="w-8 h-8 text-amber-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div>
                      <p class="text-amber-800 font-semibold">
                        <%= days_remaining %> <%= day_text %> left in trial
                      </p>
                      <p class="text-amber-600 text-sm">
                        Your subscription will start automatically on <%= Calendar.strftime(subscription.trial_end, "%B %d, %Y") %>
                      </p>
                    </div>
                  </div>
                <% end %>

                <!-- Usage Stats -->
                <%= if usage != %{} do %>
                  <div class="grid grid-cols-3 gap-4 mb-4">
                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                      <div class="text-2xl font-bold text-gray-900"><%= Map.get(usage, :buttons_used, 0) %></div>
                      <div class="text-xs text-gray-500">
                        / <%= if @subscription_info.plan.max_buttons == -1, do: "∞", else: @subscription_info.plan.max_buttons %> buttons
                      </div>
                    </div>
                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                      <div class="text-2xl font-bold text-gray-900"><%= Map.get(usage, :friends_used, 0) %></div>
                      <div class="text-xs text-gray-500">
                        / <%= if @subscription_info.plan.max_friends == -1, do: "∞", else: @subscription_info.plan.max_friends %> friends
                      </div>
                    </div>
                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                      <div class="text-2xl font-bold text-gray-900"><%= Map.get(usage, :clicks_this_month, 0) %></div>
                      <div class="text-xs text-gray-500">
                        / <%= if @subscription_info.plan.max_button_clicks_per_month == -1, do: "∞", else: @subscription_info.plan.max_button_clicks_per_month %> clicks/mo
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Upgrade/Manage Buttons -->
              <div class="flex gap-4">
                <%= if @subscription_info.plan.slug == "free" do %>
                  <a href={~p"/pricing"} class="flex-1 text-center px-4 py-2 rounded-lg transition-colors font-medium" style="background-color: #0d9488; color: white;">
                    Upgrade
                  </a>
                <% else %>
                  <button phx-click="manage_subscription" class="flex-1 text-center bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors font-medium">
                    Manage Subscription
                  </button>
                  <a href={~p"/pricing"} class="flex-1 text-center bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors font-medium">
                    View All Plans
                  </a>
                <% end %>
              </div>
            <% else %>
              <!-- No subscription info - show upgrade prompt -->
              <div class="text-center p-6 bg-gray-50 rounded-lg">
                <h3 class="text-lg font-medium text-gray-900 mb-2">Free Plan</h3>
                <p class="text-gray-600 mb-4">You're currently on the free plan. Upgrade for more features!</p>
                <a href={~p"/pricing"} class="inline-block px-6 py-2 rounded-lg transition-colors font-medium" style="background-color: #0d9488; color: white;">
                  View Plans & Pricing
                </a>
              </div>
            <% end %>
          </div>

          <!-- Teams & Organizations Section -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Teams & Organizations</h2>
            <div class="space-y-4">
              <a href={~p"/teams"} class="flex items-center justify-between p-4 bg-blue-50 rounded-lg border border-blue-200 hover:bg-blue-100 transition-colors">
                <div>
                  <h3 class="text-lg font-medium text-blue-900">Teams</h3>
                  <p class="text-blue-700 text-sm">Collaborate on buttons with your teams</p>
                </div>
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </a>

              <a href={~p"/organizations"} class="flex items-center justify-between p-4 bg-indigo-50 rounded-lg border border-indigo-200 hover:bg-indigo-100 transition-colors">
                <div>
                  <h3 class="text-lg font-medium text-indigo-900">Organizations</h3>
                  <p class="text-indigo-700 text-sm">Manage enterprise workspaces and billing</p>
                </div>
                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Account Actions Section -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Account Actions</h2>
            <div class="space-y-4">
              <!-- Logout Button -->
              <div class="flex items-center justify-between p-4 bg-red-50 rounded-lg border border-red-200">
                <div>
                  <h3 class="text-lg font-medium text-red-900">Logout</h3>
                  <p class="text-red-700 text-sm">Sign out of your account</p>
                </div>
                <button phx-click="logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
                  Logout
                </button>
              </div>

              <!-- Password Management -->
              <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                <div class="flex justify-between items-center mb-2">
                  <h3 class="text-lg font-medium text-gray-900">Password Management</h3>
                  <%= if !@editing_password do %>
                    <button
                      phx-click="start_edit_password"
                      class="px-3 py-1 text-sm font-medium rounded-lg transition-colors"
                      style="background-color: #0d9488; color: white;"
                    >
                      Change Password
                    </button>
                  <% end %>
                </div>

                <%= if @editing_password do %>
                  <form phx-submit="save_password" phx-change="validate_password" class="space-y-4 mt-4">
                    <%= if @password_error do %>
                      <div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                        <%= @password_error %>
                      </div>
                    <% end %>

                    <div>
                      <label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
                      <input
                        type="password"
                        name="password[current_password]"
                        id="current_password"
                        value={@password_form["current_password"]}
                        autocomplete="current-password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                        placeholder="Enter your current password"
                      />
                    </div>

                    <div>
                      <label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                      <input
                        type="password"
                        name="password[new_password]"
                        id="new_password"
                        value={@password_form["new_password"]}
                        autocomplete="new-password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                        placeholder="Enter your new password (min 8 characters)"
                      />
                    </div>

                    <div>
                      <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
                      <input
                        type="password"
                        name="password[confirm_password]"
                        id="confirm_password"
                        value={@password_form["confirm_password"]}
                        autocomplete="new-password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                        placeholder="Confirm your new password"
                      />
                    </div>

                    <div class="flex gap-3">
                      <button
                        type="submit"
                        class="px-4 py-2 text-sm font-medium rounded-lg transition-colors"
                        style="background-color: #0d9488; color: white;"
                      >
                        Save New Password
                      </button>
                      <button
                        type="button"
                        phx-click="cancel_edit_password"
                        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
                      >
                        Cancel
                      </button>
                    </div>
                  </form>
                <% else %>
                  <p class="text-gray-600 text-sm">Change your password and security settings</p>
                <% end %>
              </div>

              <a href={~p"/account/webhooks"} class="block p-4 bg-purple-50 rounded-lg border border-purple-200 hover:bg-purple-100 transition-colors">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-lg font-medium text-purple-900">Webhook Notifications</h3>
                    <p class="text-purple-700 text-sm">Send button clicks to external services</p>
                  </div>
                  <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                </div>
              </a>

              <div class="p-4 bg-green-50 rounded-lg border border-green-200">
                <h3 class="text-lg font-medium text-green-900 mb-4">Privacy Settings</h3>

                <div class="space-y-4">
                  <!-- Profile Visibility -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Profile Visibility</label>
                    <p class="text-xs text-gray-500 mb-2">Who can see your profile</p>
                    <select
                      phx-change="update_privacy"
                      name="value"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                    >
                      <input type="hidden" name="field" value="profile_visibility" />
                      <option value="public" selected={@current_user.profile_visibility == "public"}>Public - Anyone can see your profile</option>
                      <option value="friends" selected={@current_user.profile_visibility == "friends"}>Friends Only - Only friends can see your profile</option>
                      <option value="private" selected={@current_user.profile_visibility == "private"}>Private - Only you can see your profile</option>
                    </select>
                  </div>

                  <!-- Activity Visibility -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Activity Visibility</label>
                    <p class="text-xs text-gray-500 mb-2">Who can see your button activity</p>
                    <select
                      phx-change="update_privacy"
                      name="value"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                    >
                      <input type="hidden" name="field" value="activity_visibility" />
                      <option value="public" selected={@current_user.activity_visibility == "public"}>Public - Anyone can see your activities</option>
                      <option value="friends" selected={@current_user.activity_visibility == "friends"}>Friends Only - Only friends can see your activities</option>
                      <option value="private" selected={@current_user.activity_visibility == "private"}>Private - Only you can see your activities</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                <h3 class="text-lg font-medium text-gray-900 mb-4">Data Export</h3>
                <p class="text-gray-600 text-sm mb-4">Download your data and activity history in your preferred format:</p>

                <div class="flex gap-3">
                  <a
                    href="/api/users/export?format=json"
                    download
                    class="flex-1 text-center px-4 py-2 rounded-lg transition-colors font-medium border border-gray-300 hover:bg-gray-100"
                  >
                    Export as JSON
                  </a>
                  <a
                    href="/api/users/export?format=csv"
                    download
                    class="flex-1 text-center px-4 py-2 rounded-lg transition-colors font-medium border border-gray-300 hover:bg-gray-100"
                  >
                    Export as CSV
                  </a>
                </div>

                <p class="text-gray-400 text-xs mt-3">
                  Your export will include all your buttons, click history, friend connections, and account information.
                </p>
              </div>
            </div>
          </div>

          <!-- Support Section -->
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Support</h2>
            <div class="space-y-4">
              <a href={~p"/support"} class="flex items-center justify-between p-4 bg-blue-50 rounded-lg border border-blue-200 hover:bg-blue-100 transition-colors">
                <div>
                  <h3 class="text-lg font-medium text-blue-900">Help & Support</h3>
                  <p class="text-blue-700 text-sm">Get help or submit a support ticket</p>
                </div>
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Back to Buttons Link -->
          <div class="text-center">
            <a href={~p"/"} class="inline-flex items-center px-4 py-2 rounded-lg transition-colors" style="background-color: #0d9488; color: white;">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Buttons
            </a>
          </div>
        </div>
      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Authentication Required</h3>
          <p class="text-gray-500 mb-4">Please log in to access account settings</p>
          <a href={~p"/auth/login"} class="px-4 py-2 rounded-lg transition-colors" style="background-color: #0d9488; color: white;">
            Log In
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>



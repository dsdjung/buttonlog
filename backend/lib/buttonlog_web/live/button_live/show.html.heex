<div class="min-h-screen bg-gray-50">
  <div id="timezone-detector-show" phx-hook="TimezoneDetector" style="display: none;"></div>
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">


      <!-- Button Details Card -->
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg border border-gray-200 overflow-hidden">
          <!-- Header -->
          <div class="px-6 py-8 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold" style={"background-color: #{@button.color}"}>
                  <%= @button.icon %>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900"><%= @button.name %></h1>
                  <p class="text-lg text-gray-600 capitalize"><%= @button.type %> Button</p>
                </div>
              </div>
              
              <!-- Action buttons -->
              <div class="flex space-x-3">
                <button phx-click="delete"
                        data-confirm="Are you sure you want to delete this button?"
                        class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-colors font-medium">
                  <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  Delete
                </button>
              </div>
            </div>
          </div>

          <!-- Button Information -->
          <div class="px-6 py-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- Details -->
              <div>
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Button Details</h2>
                <dl class="space-y-4">
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Type</dt>
                    <dd class="mt-1 text-sm text-gray-900 capitalize"><%= @button.type %></dd>
                  </div>
                  
                  <%= if @button.description do %>
                    <div>
                      <dt class="text-sm font-medium text-gray-500">Description</dt>
                      <dd class="mt-1 text-sm text-gray-900"><%= @button.description %></dd>
                    </div>
                  <% end %>
                  
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Color</dt>
                    <dd class="mt-1 flex items-center">
                      <div class="w-6 h-6 rounded border border-gray-300 mr-2" style={"background-color: #{@button.color}"}></div>
                      <span class="text-sm text-gray-900"><%= @button.color %></span>
                    </dd>
                  </div>
                  
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Icon</dt>
                    <dd class="mt-1 text-2xl"><%= @button.icon %></dd>
                  </div>
                  
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Created</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                      <span id="button-created-time" phx-hook="LocalTime" data-utc={safe_to_iso8601(@button.inserted_at)}>
                        <%= Calendar.strftime(@button.inserted_at, "%B %d, %Y at %I:%M %p") %>
                      </span>
                    </dd>
                  </div>
                </dl>
              </div>

              <!-- Settings -->
              <div>
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Settings</h2>
                <div class="space-y-4">
                  <a href={~p"/buttons/#{@button.id}/notifications"} class="block">
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
                      <div>
                        <span class="font-medium text-gray-900">Friend Notifications</span>
                        <div class="flex items-center space-x-2">
                          <p class="text-sm text-gray-500">Notify your friends when button is clicked</p>
                          <%= 
                            # Get notification count for this button
                            notification_count = case ButtonLog.Notifications.get_button_notification_preferences(@button.id, @current_user.id) do
                              prefs when is_list(prefs) -> 
                                Enum.count(prefs, fn pref -> pref.enabled end)
                              _ -> 0
                            end
                          %>
                          <%= if notification_count > 0 do %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                              <%= notification_count %> friend<%= if notification_count != 1, do: "s", else: "" %> selected
                            </span>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex items-center space-x-2">
                        <span class={[
                          "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
                          if(@button.notifications_enabled, do: "bg-green-100 text-green-800", else: "bg-gray-100 text-gray-800")
                        ]}>
                          <%= if @button.notifications_enabled, do: "Configure", else: "Configure" %>
                        </span>
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                  </a>
                  
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div>
                      <span class="font-medium text-gray-900">Auto-stop</span>
                      <p class="text-sm text-gray-500">Automatically stop timed buttons</p>
                    </div>
                    <span class={[
                      "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
                      if(@button.auto_stop_enabled, do: "bg-blue-100 text-blue-800", else: "bg-gray-100 text-gray-800")
                    ]}>
                      <%= if @button.auto_stop_enabled, do: "Enabled", else: "Disabled" %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Activity History Section -->
        <div class="mt-8 bg-white rounded-lg shadow-lg border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">Activity History</h2>
            <p class="text-sm text-gray-500 mt-1">Recent button clicks and activities</p>
          </div>
          
          <div class="px-6 py-6">
            <%= if Enum.empty?(@button_clicks) do %>
              <div class="text-center text-gray-500">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <h3 class="mt-4 text-lg font-medium text-gray-900">No activity yet</h3>
                <p class="mt-2 text-sm text-gray-500">Activity history will appear here when you start clicking the button.</p>
              </div>
            <% else %>
              <div class="space-y-4">
                <%= for click <- @button_clicks do %>
                  <div class="flex items-center justify-between py-3 px-4 bg-gray-50 rounded-lg">
                    <div class="flex items-center space-x-3">
                      <div class="flex-shrink-0">
                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                        </div>
                      </div>
                      <div>
                        <p class="text-sm font-medium text-gray-900">
                          <%= case click.action do %>
                            <% "start" -> %><span class="text-green-700">Started</span>
                            <% "end" -> %><span class="text-blue-700">Ended</span>
                            <% _ -> %>Button clicked
                          <% end %>
                        </p>
                        <p class="text-xs text-gray-500">From <%= click.platform %></p>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-sm text-gray-900">
                        <span id={"click-time-#{click.id}"} phx-hook="LocalTime" data-utc={safe_to_iso8601(click.clicked_at)}>
                          <%= Calendar.strftime(click.clicked_at, "%m/%d %I:%M %p") %>
                        </span>
                      </p>
                      <%= if click.duration do %>
                        <p class="text-xs text-gray-500"><%= click.duration %>s</p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
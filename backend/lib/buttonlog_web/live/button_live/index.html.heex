<div class="min-h-screen bg-gray-50">
  <div id="timezone-detector-index" phx-hook="TimezoneDetector" style="display: none;"></div>
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <!-- Header with New Button -->
      <%= if @authenticated do %>
        <div class="text-center">
          <button phx-click="show_create_form" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors text-lg font-medium">
            New Button
          </button>
        </div>
        
        <!-- Simple form for testing -->
        <%= if @show_create_form do %>
          <div class="mt-8 max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-lg font-semibold text-gray-900">Create Button</h2>
              <button phx-click="hide_create_form" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <form phx-submit="create_button" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Name</label>
                <input type="text" name="button[name]" required class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Type</label>
                <select name="button[type]" required class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg">
                  <option value="">Select type</option>
                  <option value="instant">⚡ Instant - Single click actions</option>
                  <option value="toggle">🔄 Toggle - Start/stop with duration tracking</option>
                  <option value="one-time">1️⃣ One-Time - Use once, then archived</option>
                  <option value="workflow">📋 Workflow - Predefined sequence of states</option>
                </select>
              </div>
              <div class="flex space-x-3">
                <button type="submit" class="flex-1 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
                  Create Button
                </button>
                <button type="button" phx-click="hide_create_form" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                  Cancel
                </button>
              </div>
            </form>
          </div>
        <% end %>
        
        <!-- Buttons List - Single Column -->
        <div class="mt-8 space-y-4">
          <%= for button <- @buttons do %>
            <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-200">
              <div class="flex">
                
                <!-- Left side: Button Click Area (4/5) -->
                <div style="width: 80%;" class="cursor-pointer bg-green-50 hover:bg-green-100 transition-colors relative"
                     phx-click="click" phx-value-id={button.id}>
                  <div class="p-6">
                    <div class="flex items-center space-x-4 mb-4">
                      <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold flex-shrink-0" style={"background-color: #{button.color}"}>
                        <%= case button.icon do %>
                          <% "star" -> %>⭐
                          <% "heart" -> %>❤️
                          <% "bolt" -> %>⚡
                          <% "flame" -> %>🔥
                          <% "leaf" -> %>🍃
                          <% "drop" -> %>💧
                          <% "sun" -> %>☀️
                          <% "moon" -> %>🌙
                          <% "car" -> %>🚗
                          <% "book" -> %>📚
                          <% "pencil" -> %>✏️
                          <% "gear" -> %>⚙️
                          <% _ -> %>📱
                        <% end %>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center space-x-3 mb-2">
                          <!-- Type-specific icon -->
                          <div class="text-xl">
                            <%= case button.type do %>
                              <% "instant" -> %>⚡
                              <% "toggle" -> %>🔄
                              <% "one-time" -> %>1️⃣
                              <% "workflow" -> %>📋
                              <% _ -> %>📱
                            <% end %>
                          </div>
                          <h3 class="text-2xl font-semibold text-gray-900 break-words"><%= button.name %></h3>
                        </div>
                        <p class="text-base text-gray-500 mb-3">
                          <%= if button.latest_click_at do %>
                            <span id={"button-latest-click-#{button.id}"} phx-hook="LocalTime" data-utc={safe_to_iso8601(button.latest_click_at)}>
                              Last clicked: <%= Calendar.strftime(button.latest_click_at, "%m/%d %I:%M %p") %>
                            </span>
                            <%= if button.type == "toggle" and button.current_state == "active" do %>
                              <span class="ml-2 text-sm font-medium">
                                • <span class="text-green-600">In Progress</span>
                              </span>
                            <% end %>
                          <% else %>
                            Never clicked
                          <% end %>
                        </p>
                        
                        <%= if button.description do %>
                          <p class="text-gray-700 mb-4 text-base break-words"><%= button.description %></p>
                        <% end %>
                        
                        <!-- Settings badges -->
                        <div class="flex flex-wrap gap-3">
                          <%= if button.user_id != @current_user.id do %>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-800">
                              👥 Shared
                            </span>
                          <% end %>
                          <%= if button.auto_stop_enabled and button[:auto_stop_minutes] do %>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                              ⏹️ Auto-stop: <%= format_auto_stop_duration(button[:auto_stop_minutes]) %>
                            </span>
                          <% else %>
                            <%= if button.auto_stop_enabled do %>
                              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                ⏹️ Auto-stop
                              </span>
                            <% end %>
                          <% end %>
                          <%= if button[:scheduled_stop_at] && button.current_state == "active" do %>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                              ⏰ Auto-stops in <%= format_time_remaining(button[:scheduled_stop_at]) %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Right side: Edit Button (1/5) -->
                <div style="width: 20%;" class="bg-blue-50 hover:bg-blue-100 cursor-pointer transition-colors border-l border-gray-200 flex items-center justify-center"
                     phx-click="edit" phx-value-id={button.id}>
                  <div class="text-3xl text-blue-700">⚙️</div>
                </div>
                
              </div>
            </div>
          <% end %>
        </div>

        <!-- Empty State -->
        <%= if Enum.empty?(@buttons) do %>
          <div class="text-center py-12">
            <div class="text-gray-400 mb-4">
              <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No buttons yet</h3>
            <p class="text-gray-500 mb-4">Create your first button to get started</p>
            <button phx-click="show_create_form" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">
              Create Button
            </button>
          </div>
        <% end %>
        
      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Authentication Required</h3>
          <p class="text-gray-500 mb-4">Please log in to access your buttons</p>
          <a href={~p"/auth/login"} class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            Log In
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

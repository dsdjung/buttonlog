<div class="min-h-screen bg-gray-50">
  <div id="timezone-detector-index" phx-hook="TimezoneDetector" style="display: none;"></div>

  <!-- Upgrade Prompt Modal -->
  <%= if @upgrade_info do %>
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="upgrade-modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" phx-click="dismiss_upgrade"></div>

        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full">
          <div class="bg-white px-6 pt-6 pb-4">
            <!-- Crown Icon -->
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-yellow-100 mb-4">
              <svg class="h-10 w-10 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5z"/>
                <path d="M19 19H5v-2h14v2z"/>
              </svg>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-900 text-center mb-2" id="upgrade-modal-title">
              Upgrade Required
            </h3>

            <!-- Message -->
            <p class="text-gray-600 text-center mb-4">
              <%= @upgrade_info.message %>
            </p>

            <!-- Usage Info -->
            <%= if Map.get(@upgrade_info, :current_usage) && Map.get(@upgrade_info, :limit) do %>
              <div class="flex justify-between items-center px-4 py-3 bg-gray-50 rounded-lg mb-4">
                <span class="text-sm text-gray-600">Current usage:</span>
                <span class="text-sm font-semibold text-gray-900">
                  <%= @upgrade_info.current_usage %> / <%= @upgrade_info.limit %>
                </span>
              </div>
            <% end %>

            <!-- Upgrade Benefit -->
            <div class="flex items-start gap-2 text-sm text-gray-500 mb-6">
              <svg class="h-5 w-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span><%= @upgrade_info.upgrade_benefit %></span>
            </div>
          </div>

          <!-- Actions -->
          <div class="bg-gray-50 px-6 py-4 flex flex-col gap-3">
            <a href={~p"/account"} class="w-full flex items-center justify-center px-4 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-600 transition-colors">
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
              </svg>
              Upgrade to <%= String.capitalize(@upgrade_info.recommended_plan || "Premium") %>
            </a>
            <button phx-click="dismiss_upgrade" class="w-full px-4 py-2 text-gray-600 font-medium hover:text-gray-800 transition-colors">
              Maybe Later
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <!-- Header with New Button -->
      <%= if @authenticated do %>
        <div class="text-center mb-6">
          <button phx-click="show_create_form" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary-600 transition-colors text-lg font-medium">
            New Button
          </button>
        </div>

        <!-- Search and Filter Bar -->
        <div class="mb-6 bg-white rounded-xl shadow-sm border border-gray-200 p-4 max-w-2xl mx-auto">
          <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
            <!-- Search Input -->
            <div class="flex-1 relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <input
                type="text"
                name="search"
                value={@search_query}
                phx-keyup="search"
                phx-debounce="300"
                placeholder="Search buttons..."
                class="block w-full h-10 pl-10 pr-10 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
              />
              <%= if @search_query != "" do %>
                <button
                  phx-click="clear_search"
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
                >
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              <% end %>
            </div>

            <!-- Type Filter -->
            <div class="relative sm:w-40">
              <select
                name="filter_type"
                phx-change="filter_type"
                class="block w-full h-10 pl-3 pr-8 text-sm border border-gray-300 bg-gray-50 rounded-lg appearance-none focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors cursor-pointer"
              >
                <option value="all" selected={@filter_type == "all"}>All Types</option>
                <option value="instant" selected={@filter_type == "instant"}>Instant</option>
                <option value="toggle" selected={@filter_type == "toggle"}>Toggle</option>
                <option value="one-time" selected={@filter_type == "one-time"}>One-Time</option>
                <option value="workflow" selected={@filter_type == "workflow"}>Workflow</option>
              </select>
              <!-- Custom dropdown arrow -->
              <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Results count -->
          <%= if @search_query != "" || @filter_type != "all" do %>
            <div class="mt-3 pt-3 border-t border-gray-100 text-sm text-gray-500">
              Showing <span class="font-medium text-gray-700"><%= length(@buttons) %></span> of <%= length(@all_buttons) %> buttons
              <%= if @search_query != "" do %>
                matching "<span class="font-medium"><%= @search_query %></span>"
              <% end %>
              <%= if @filter_type != "all" do %>
                <span class="inline-flex items-center ml-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                  <%= @filter_type %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Create Button Form -->
        <%= if @show_create_form do %>
          <div class="mb-6 max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex justify-between items-center px-4 py-3 bg-gray-50 border-b border-gray-200">
              <h2 class="text-base font-semibold text-gray-900">Create New Button</h2>
              <button phx-click="hide_create_form" class="p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-200 rounded-full transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <form phx-submit="create_button" phx-change="validate_create_button" class="p-4 space-y-4" x-data="{ buttonType: '', choices: ['', ''], buttonName: '', friendAlertMode: 'none', selectedFriendIds: [] }">
              <!-- Quick Templates -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Quick Templates</label>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    @click="buttonType = 'one-time'; choices = ['Yes', 'No']; $refs.nameInput.focus()"
                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-full bg-purple-50 text-purple-700 border border-purple-200 hover:bg-purple-100 transition-colors"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Yes/No Question
                  </button>
                  <button
                    type="button"
                    @click="buttonType = 'one-time'; choices = ['Done', 'Skip']; $refs.nameInput.focus()"
                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-full bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 transition-colors"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Done/Skip Task
                  </button>
                  <button
                    type="button"
                    @click="buttonType = 'one-time'; choices = ['Good', 'Okay', 'Bad']; $refs.nameInput.focus()"
                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-full bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition-colors"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                    Rating
                  </button>
                </div>
                <p class="text-xs text-gray-500 mt-1.5">Or create a custom button below</p>
              </div>

              <hr class="border-gray-200">

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                <input
                  type="text"
                  name="button[name]"
                  x-ref="nameInput"
                  required
                  placeholder="Enter button name"
                  class="w-full h-10 px-3 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <div class="relative">
                  <select
                    name="button[type]"
                    required
                    x-model="buttonType"
                    class="w-full h-10 pl-3 pr-8 text-sm border border-gray-300 rounded-lg bg-gray-50 appearance-none focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors cursor-pointer"
                  >
                    <option value="">Select type</option>
                    <option value="instant">Instant - Single click actions</option>
                    <option value="toggle">Toggle - Start/stop with duration tracking</option>
                    <option value="one-time">One-Time - Use once, then archived</option>
                    <option value="workflow">Workflow - Predefined sequence of states</option>
                  </select>
                  <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                    <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Choices Section (only for one-time buttons) -->
              <div x-show="buttonType === 'one-time'" x-transition class="space-y-3">
                <label class="block text-sm font-medium text-gray-700">Choices (Optional)</label>
                <p class="text-xs text-gray-500 -mt-1">Add multiple choice options for this button</p>
                <template x-for="(choice, index) in choices" x-bind:key="index">
                  <div class="flex gap-2 items-center">
                    <input
                      type="text"
                      x-bind:name="'button[choices][' + index + ']'"
                      x-model="choices[index]"
                      x-bind:placeholder="'Choice ' + (index + 1)"
                      class="flex-1 h-9 px-3 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                    />
                    <button
                      type="button"
                      x-show="choices.length > 2"
                      @click="choices.splice(index, 1)"
                      class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-full transition-colors"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </template>
                <button
                  type="button"
                  x-show="choices.length < 10"
                  @click="choices.push('')"
                  class="flex items-center text-sm text-primary hover:text-primary-600 transition-colors"
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Add Choice
                </button>
              </div>

              <!-- Friend Notifications Section (Collapsible) -->
              <%= if length(@friends) > 0 do %>
                <div class="border-t border-gray-200 pt-4">
                  <details class="group">
                    <summary class="flex items-center cursor-pointer text-sm font-medium text-gray-700 select-none">
                      <svg class="w-4 h-4 mr-2 transform transition-transform group-open:rotate-90 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                      <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                      </svg>
                      Friend Notifications (Optional)
                    </summary>
                    <div class="mt-3 ml-6 space-y-3">
                      <p class="text-xs text-gray-500">Notify friends when you click this button</p>

                      <!-- Hidden input to pass the mode -->
                      <input type="hidden" name="button[friend_alerts][mode]" x-bind:value="friendAlertMode" />

                      <!-- Radio Options -->
                      <div class="space-y-2">
                        <label class="flex items-center cursor-pointer">
                          <input type="radio" x-model="friendAlertMode" value="none" class="w-4 h-4 text-primary border-gray-300 focus:ring-primary/20" />
                          <span class="ml-2 text-sm text-gray-700">None - Only I see this button</span>
                        </label>
                        <label class="flex items-center cursor-pointer">
                          <input type="radio" x-model="friendAlertMode" value="all_friends" class="w-4 h-4 text-primary border-gray-300 focus:ring-primary/20" />
                          <span class="ml-2 text-sm text-gray-700">All Friends - Notify all friends when clicked</span>
                        </label>
                        <label class="flex items-center cursor-pointer">
                          <input type="radio" x-model="friendAlertMode" value="select_specific" class="w-4 h-4 text-primary border-gray-300 focus:ring-primary/20" />
                          <span class="ml-2 text-sm text-gray-700">Select Specific Friends</span>
                        </label>
                      </div>

                      <!-- Friend Checkboxes (shown when select_specific) -->
                      <div x-show="friendAlertMode === 'select_specific'" x-transition class="ml-6 space-y-2 pt-2 border-t border-gray-100">
                        <%= for friend <- @friends do %>
                          <label class="flex items-center cursor-pointer py-1">
                            <input
                              type="checkbox"
                              name="button[friend_alerts][friend_ids][]"
                              value={friend.id}
                              x-on:change="$event.target.checked ? selectedFriendIds.push($event.target.value) : selectedFriendIds = selectedFriendIds.filter(id => id !== $event.target.value)"
                              class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary/20"
                            />
                            <span class="ml-2 text-sm text-gray-700"><%= friend.display_name || friend.username %></span>
                          </label>
                        <% end %>
                      </div>
                    </div>
                  </details>
                </div>
              <% end %>

              <div class="flex gap-3 pt-2">
                <button type="submit" class="flex-1 h-10 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-600 transition-colors">
                  Create Button
                </button>
                <button type="button" phx-click="hide_create_form" class="px-5 h-10 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
                  Cancel
                </button>
              </div>
            </form>
          </div>
        <% end %>

        <!-- Buttons List - Card Style like Mobile Apps -->
        <div class="mt-8 space-y-4 max-w-2xl mx-auto">
          <%= for button <- @buttons do %>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
              <div class="p-4">
                <!-- Header Row: Icon, Name, Description, and Three-dot Menu -->
                <div class="flex items-start">
                  <!-- Icon Circle -->
                  <div class="w-11 h-11 rounded-full flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style={"background-color: #{button.color || "#00BFA5"}"}>
                    <%= case button.icon do %>
                      <% "star" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      <% "heart" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                      <% "bolt" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
                      <% "flame" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/></svg>
                      <% "leaf" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.5 3A1.5 1.5 0 003 4.5v11A1.5 1.5 0 004.5 17h11a1.5 1.5 0 001.5-1.5v-11A1.5 1.5 0 0015.5 3h-11z" clip-rule="evenodd"/></svg>
                      <% "drop" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 00-.894.553L6.382 8H3a1 1 0 000 2h3.382l2.724 5.447A1 1 0 0010 16h.001a1 1 0 00.894-.553L13.618 10H17a1 1 0 000-2h-3.382l-2.724-5.447A1 1 0 0010 2z" clip-rule="evenodd"/></svg>
                      <% "sun" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
                      <% "moon" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
                      <% "car" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1v-1h3v1a1 1 0 001 1h.05a2.5 2.5 0 014.9 0H21a1 1 0 001-1V5a1 1 0 00-1-1H3z"/></svg>
                      <% "book" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
                      <% "pencil" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                      <% "gear" -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                      <% _ -> %><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
                    <% end %>
                  </div>

                  <!-- Name and Description -->
                  <div class="flex-1 min-w-0 ml-3">
                    <h3 class="text-lg font-semibold text-gray-900 break-words"><%= button.name %></h3>
                    <%= if button.description do %>
                      <p class="text-sm text-gray-500 mt-0.5 break-words line-clamp-2"><%= button.description %></p>
                    <% end %>

                    <!-- Tags Row -->
                    <div class="flex flex-wrap gap-2 mt-2">
                      <!-- Type Tag -->
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                        <%= case button.type do %>
                          <% "instant" -> %>Instant
                          <% "toggle" -> %>Toggle
                          <% "one-time" -> %>One-Time
                          <% "workflow" -> %>Workflow
                          <% _ -> %><%= button.type %>
                        <% end %>
                      </span>

                      <!-- Active State Tag (for toggle buttons) -->
                      <%= if button.type == "toggle" and button.current_state == "active" do %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">
                          Active
                        </span>
                      <% end %>

                      <!-- Gift From Tag (for buttons created by friends) -->
                      <%= if button.created_by_friend_id do %>
                        <% gifter_name = case button.created_by_friend do
                          %{display_name: dn} when not is_nil(dn) and dn != "" -> dn
                          %{username: un} when not is_nil(un) -> un
                          _ -> "a friend"
                        end %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-pink-100 text-pink-700">
                          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 5a3 3 0 015-2.236A3 3 0 0114.83 6H16a2 2 0 110 4h-5V9a1 1 0 10-2 0v1H4a2 2 0 110-4h1.17C5.06 5.687 5 5.35 5 5zm4 1V5a1 1 0 10-1 1h1zm3 0a1 1 0 10-1-1v1h1z" clip-rule="evenodd"/>
                            <path d="M9 11H3v5a2 2 0 002 2h4v-7zM11 18h4a2 2 0 002-2v-5h-6v7z"/>
                          </svg>
                          Gift from <%= gifter_name %>
                        </span>
                      <% end %>

                      <!-- Shared Tag -->
                      <%= if button.user_id != @current_user.id do %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">
                          Shared
                        </span>
                      <% end %>

                      <!-- Auto-stop Tag -->
                      <%= if button.auto_stop_enabled do %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">
                          <%= if button[:auto_stop_minutes] do %>
                            Auto-stop: <%= format_auto_stop_duration(button[:auto_stop_minutes]) %>
                          <% else %>
                            Auto-stop
                          <% end %>
                        </span>
                      <% end %>
                    </div>

                    <!-- Last Clicked -->
                    <p class="text-xs text-gray-400 mt-2">
                      <%= if button.latest_click_at do %>
                        <span id={"button-latest-click-#{button.id}"} phx-hook="LocalTime" data-utc={safe_to_iso8601(button.latest_click_at)}>
                          Last: <%= Calendar.strftime(button.latest_click_at, "%m/%d %I:%M %p") %>
                        </span>
                        <%= if button[:scheduled_stop_at] && button.current_state == "active" do %>
                          <span class="ml-2 text-yellow-600">
                            • Stops in <%= format_time_remaining(button[:scheduled_stop_at]) %>
                          </span>
                        <% end %>
                      <% else %>
                        Never clicked
                      <% end %>
                    </p>
                  </div>

                  <!-- Three-dot Menu -->
                  <div class="relative ml-2 flex-shrink-0" x-data="{ open: false }">
                    <button
                      type="button"
                      @click="open = !open"
                      @click.outside="open = false"
                      class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors"
                      aria-label="Button options"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                      </svg>
                    </button>

                    <!-- Dropdown Menu -->
                    <div
                      x-show="open"
                      x-transition:enter="transition ease-out duration-100"
                      x-transition:enter-start="transform opacity-0 scale-95"
                      x-transition:enter-end="transform opacity-100 scale-100"
                      x-transition:leave="transition ease-in duration-75"
                      x-transition:leave-start="transform opacity-100 scale-100"
                      x-transition:leave-end="transform opacity-0 scale-95"
                      class="absolute right-0 top-full mt-1 w-44 bg-white rounded-lg shadow-lg border border-gray-200 py-1.5 z-20"
                      style="display: none;"
                    >
                      <a href={~p"/buttons/#{button.id}"} class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
                        <svg class="w-4 h-4 mr-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        View Details
                      </a>
                      <%= if button.user_id == @current_user.id do %>
                        <button phx-click="edit" phx-value-id={button.id} @click="open = false" class="flex items-center w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
                          <svg class="w-4 h-4 mr-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        </button>
                        <div class="border-t border-gray-100 my-1.5"></div>
                        <button
                          phx-click="delete"
                          phx-value-id={button.id}
                          @click="open = false"
                          data-confirm="Are you sure you want to delete this button? This action cannot be undone."
                          class="flex items-center w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors"
                        >
                          <svg class="w-4 h-4 mr-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                          Delete
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Click Button (Separate from card info) -->
                <%= if button.type == "one-time" and is_list(button.choices) and length(button.choices) >= 2 do %>
                  <!-- Choice Buttons for one-time buttons with multiple choices -->
                  <div class="mt-4 space-y-2">
                    <p class="text-xs text-gray-500 text-center mb-2">Select an option:</p>
                    <div class="grid grid-cols-2 gap-2">
                      <%= for choice <- button.choices do %>
                        <button
                          phx-click="click_with_choice"
                          phx-value-id={button.id}
                          phx-value-choice={choice}
                          class="flex items-center justify-center px-3 py-2.5 rounded-lg text-white font-medium text-sm transition-all duration-150 hover:opacity-90 active:scale-[0.98]"
                          style={"background-color: #{button.color || "#00BFA5"}"}
                        >
                          <svg class="w-4 h-4 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          <span class="truncate"><%= choice %></span>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <button
                    phx-click="click"
                    phx-value-id={button.id}
                    class="mt-4 w-full flex items-center justify-center px-4 py-3 rounded-lg text-white font-medium transition-all duration-150 hover:opacity-90 active:scale-[0.98]"
                    style={"background-color: #{button.color || "#00BFA5"}"}
                  >
                    <%= case button.type do %>
                      <% "instant" -> %>
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
                        </svg>
                        Click!
                      <% "toggle" -> %>
                        <%= if button.current_state == "active" do %>
                          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd"/>
                          </svg>
                          Stop
                        <% else %>
                          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                          </svg>
                          Start
                        <% end %>
                      <% "one-time" -> %>
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Complete
                      <% "workflow" -> %>
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                        </svg>
                        Next
                      <% _ -> %>
                        Click
                    <% end %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Empty State -->
        <%= if Enum.empty?(@buttons) do %>
          <%= if @search_query != "" || @filter_type != "all" do %>
            <!-- No results from search/filter -->
            <div class="text-center py-12">
              <div class="text-gray-400 mb-4">
                <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No buttons found</h3>
              <p class="text-gray-500 mb-4">
                Try adjusting your search or filter criteria
              </p>
              <button phx-click="clear_search" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors">
                Clear Search
              </button>
            </div>
          <% else %>
            <!-- No buttons at all -->
            <div class="text-center py-12">
              <div class="text-gray-400 mb-4">
                <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No buttons yet</h3>
              <p class="text-gray-500 mb-4">Create your first button to get started</p>
              <button phx-click="show_create_form" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors">
                Create Button
              </button>
            </div>
          <% end %>
        <% end %>

      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Authentication Required</h3>
          <p class="text-gray-500 mb-4">Please log in to access your buttons</p>
          <a href={~p"/auth/login"} class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors">
            Log In
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

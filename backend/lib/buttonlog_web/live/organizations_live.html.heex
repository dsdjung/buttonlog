<div class="min-h-screen bg-gray-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <%= if @current_user do %>
        <div class="max-w-4xl mx-auto">
          <!-- Page Header -->
          <div class="flex items-center justify-between mb-8">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Organizations</h1>
              <p class="text-gray-600 mt-1">Manage enterprise organizations and teams</p>
            </div>
            <button
              phx-click="show_create_modal"
              class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Create Organization
            </button>
          </div>

          <!-- Pending Invitations -->
          <%= if length(@invitations) > 0 do %>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
              <h2 class="text-lg font-semibold text-yellow-900 mb-3">
                <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Pending Invitations (<%= length(@invitations) %>)
              </h2>
              <div class="space-y-3">
                <%= for invitation <- @invitations do %>
                  <div class="flex items-center justify-between bg-white p-3 rounded-lg border border-yellow-200">
                    <div>
                      <p class="font-medium text-gray-900">
                        <%= invitation.organization.name %>
                      </p>
                      <p class="text-sm text-gray-600">
                        Invited by <%= invitation.inviter.display_name || invitation.inviter.username %>
                        as <%= invitation.role %>
                      </p>
                    </div>
                    <div class="flex gap-2">
                      <button
                        phx-click="accept_invitation"
                        phx-value-id={invitation.id}
                        class="px-3 py-1 bg-green-600 text-white text-sm rounded hover:bg-green-700 transition-colors"
                      >
                        Accept
                      </button>
                      <button
                        phx-click="decline_invitation"
                        phx-value-id={invitation.id}
                        class="px-3 py-1 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300 transition-colors"
                      >
                        Decline
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Organizations List -->
          <%= if length(@organizations) == 0 do %>
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-12 text-center">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No organizations yet</h3>
              <p class="text-gray-500 mb-4">Create an organization to manage teams and enterprise features</p>
              <button
                phx-click="show_create_modal"
                class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
              >
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Create Your First Organization
              </button>
            </div>
          <% else %>
            <div class="grid gap-4">
              <%= for org <- @organizations do %>
                <% role = get_user_role(org, @current_user.id) %>
                <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow">
                  <div class="flex items-start justify-between">
                    <div class="flex items-center gap-4">
                      <!-- Organization Icon -->
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                        <%= if org.logo_url do %>
                          <img src={org.logo_url} alt={org.name} class="w-10 h-10 rounded" />
                        <% else %>
                          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                          </svg>
                        <% end %>
                      </div>

                      <div>
                        <h3 class="text-lg font-semibold text-gray-900"><%= org.name %></h3>
                        <%= if org.description do %>
                          <p class="text-gray-600 text-sm"><%= org.description %></p>
                        <% end %>
                        <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
                          <span class="flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                            </svg>
                            <%= if org.subscription, do: "#{org.subscription.seats_used}/#{org.subscription.seats_purchased} seats", else: "No subscription" %>
                          </span>
                          <span class={"px-2 py-0.5 rounded-full text-xs font-medium #{role_badge_class(role)}"}>
                            <%= String.capitalize(role || "member") %>
                          </span>
                          <%= if org.subscription do %>
                            <span class={"px-2 py-0.5 rounded-full text-xs font-medium #{if org.subscription.status == "active", do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800"}"}>
                              <%= String.capitalize(org.subscription.status) %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    </div>

                    <div class="flex items-center gap-2">
                      <a
                        href={~p"/organizations/#{org.id}"}
                        class="px-3 py-1.5 bg-purple-600 text-white text-sm rounded hover:bg-purple-700 transition-colors"
                      >
                        Manage
                      </a>
                      <%= if role != "owner" do %>
                        <button
                          phx-click="leave_org"
                          phx-value-id={org.id}
                          data-confirm="Are you sure you want to leave this organization?"
                          class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300 transition-colors"
                        >
                          Leave
                        </button>
                      <% else %>
                        <button
                          phx-click="delete_org"
                          phx-value-id={org.id}
                          data-confirm="Are you sure you want to delete this organization? This will remove all teams and cannot be undone."
                          class="px-3 py-1.5 bg-red-100 text-red-700 text-sm rounded hover:bg-red-200 transition-colors"
                        >
                          Delete
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Create Organization Modal -->
        <%= if @show_create_modal do %>
          <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <h2 class="text-xl font-semibold text-gray-900">Create Organization</h2>
                  <button
                    phx-click="hide_create_modal"
                    class="text-gray-400 hover:text-gray-600"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                </div>

                <.form for={@new_org_form} phx-submit="create_org" phx-change="validate_org" class="space-y-4">
                  <div>
                    <label for="org_name" class="block text-sm font-medium text-gray-700 mb-1">
                      Organization Name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      name="name"
                      id="org_name"
                      value={@new_org_form.params["name"]}
                      placeholder="Acme Inc."
                      required
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    />
                  </div>

                  <div>
                    <label for="org_description" class="block text-sm font-medium text-gray-700 mb-1">
                      Description
                    </label>
                    <textarea
                      name="description"
                      id="org_description"
                      rows="2"
                      placeholder="What does this organization do?"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    ><%= @new_org_form.params["description"] %></textarea>
                  </div>

                  <div>
                    <label for="billing_email" class="block text-sm font-medium text-gray-700 mb-1">
                      Billing Email
                    </label>
                    <input
                      type="email"
                      name="billing_email"
                      id="billing_email"
                      value={@new_org_form.params["billing_email"]}
                      placeholder="billing@company.com"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    />
                    <p class="text-xs text-gray-500 mt-1">For subscription and invoice notifications</p>
                  </div>

                  <div class="flex justify-end gap-3 pt-4">
                    <button
                      type="button"
                      phx-click="hide_create_modal"
                      class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
                    >
                      Create Organization
                    </button>
                  </div>
                </.form>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Authentication Required</h3>
          <p class="text-gray-500 mb-4">Please log in to access organizations</p>
          <a href={~p"/auth/login"} class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition-colors">
            Log In
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <%= if @selected_ticket do %>
      <!-- Ticket Detail View -->
      <div class="mb-6">
        <button phx-click="back_to_list" class="text-blue-600 hover:text-blue-800 font-medium flex items-center">
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Tickets
        </button>
      </div>

      <!-- Ticket Header -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="flex items-start justify-between">
          <div class="flex items-start space-x-4">
            <div class={"flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-#{status_color(@selected_ticket.status)}-100"}>
              <svg class={"w-6 h-6 text-#{status_color(@selected_ticket.status)}-600"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <%= case category_icon(@selected_ticket.category) do %>
                  <% "bug" -> %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  <% "lightbulb" -> %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  <% "question-mark-circle" -> %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  <% _ -> %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                <% end %>
              </svg>
            </div>
            <div>
              <h1 class="text-xl font-bold text-gray-900"><%= @selected_ticket.subject %></h1>
              <div class="flex items-center space-x-4 mt-2">
                <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{status_color(@selected_ticket.status)}-100 text-#{status_color(@selected_ticket.status)}-800"}>
                  <%= status_display(@selected_ticket.status) %>
                </span>
                <span class="text-sm text-gray-500">
                  <%= category_display(@selected_ticket.category) %>
                </span>
                <span class="text-sm text-gray-500">
                  Priority: <%= priority_display(@selected_ticket.priority) %>
                </span>
              </div>
              <p class="text-sm text-gray-500 mt-1">
                Created <%= format_datetime(@selected_ticket.inserted_at) %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Messages -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Conversation</h2>
        </div>

        <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
          <%= if @selected_ticket.messages && length(@selected_ticket.messages) > 0 do %>
            <%= for message <- @selected_ticket.messages do %>
              <div class={"p-6 #{if message.sender_id != @current_user.id, do: "bg-blue-50", else: "bg-white"}"}>
                <div class="flex items-start space-x-4">
                  <div class={"flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center #{if message.sender_id != @current_user.id, do: "bg-blue-200", else: "bg-gray-200"}"}>
                    <%= if message.sender_id != @current_user.id do %>
                      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                      </svg>
                    <% else %>
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    <% end %>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between">
                      <span class="font-medium text-gray-900">
                        <%= if message.sender_id != @current_user.id, do: "Support Team", else: "You" %>
                      </span>
                      <span class="text-xs text-gray-500">
                        <%= format_datetime(message.inserted_at) %>
                      </span>
                    </div>
                    <p class="mt-1 text-gray-700 whitespace-pre-wrap"><%= message.content %></p>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-6 text-center text-gray-500">
              No messages yet.
            </div>
          <% end %>
        </div>

        <!-- Reply Form -->
        <%= if is_active_status?(@selected_ticket.status) do %>
          <div class="p-6 border-t border-gray-200 bg-gray-50">
            <form phx-submit="send_message">
              <div class="mb-4">
                <label for="message" class="sr-only">Your reply</label>
                <textarea
                  id="message"
                  rows="3"
                  class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                  placeholder="Type your reply..."
                  phx-change="update_new_message"
                  phx-debounce="300"
                  value={@new_message}
                ><%= @new_message %></textarea>
              </div>
              <div class="flex justify-end">
                <button
                  type="submit"
                  class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled={String.trim(@new_message) == ""}
                >
                  Send Reply
                </button>
              </div>
            </form>
          </div>
        <% else %>
          <div class="p-6 border-t border-gray-200 bg-gray-100 text-center">
            <p class="text-gray-600">This ticket is <%= String.downcase(status_display(@selected_ticket.status)) %> and cannot receive new messages.</p>
          </div>
        <% end %>
      </div>

    <% else %>
      <!-- Tickets List View -->
      <div class="mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Help & Support</h1>
            <p class="text-gray-600 mt-2">View your support tickets or create a new one</p>
          </div>
          <div class="flex items-center space-x-4">
            <%= if @unread_count > 0 do %>
              <div class="text-sm text-gray-500">
                <span class="font-medium text-blue-600"><%= @unread_count %></span> with updates
              </div>
            <% end %>
            <button
              phx-click="show_new_ticket_form"
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
            >
              New Ticket
            </button>
          </div>
        </div>
      </div>

      <!-- New Ticket Modal -->
      <%= if @show_new_ticket_form do %>
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div class="bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6 border-b border-gray-200">
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-gray-900">Create New Ticket</h2>
                <button phx-click="hide_new_ticket_form" class="text-gray-400 hover:text-gray-600">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
            </div>

            <form phx-submit="create_ticket" class="p-6 space-y-4">
              <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
                <input
                  type="text"
                  id="subject"
                  class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                  placeholder="Brief description of your issue"
                  value={@new_ticket_form.subject}
                  phx-change="update_new_ticket_form"
                  phx-value-field="subject"
                  phx-debounce="300"
                />
              </div>

              <div>
                <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select
                  id="category"
                  class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                  phx-change="update_new_ticket_form"
                  phx-value-field="category"
                >
                  <option value="question" selected={@new_ticket_form.category == "question"}>Question</option>
                  <option value="bug" selected={@new_ticket_form.category == "bug"}>Bug Report</option>
                  <option value="feature_request" selected={@new_ticket_form.category == "feature_request"}>Feature Request</option>
                  <option value="other" selected={@new_ticket_form.category == "other"}>Other</option>
                </select>
              </div>

              <div>
                <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
                <select
                  id="priority"
                  class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                  phx-change="update_new_ticket_form"
                  phx-value-field="priority"
                >
                  <option value="low" selected={@new_ticket_form.priority == "low"}>Low</option>
                  <option value="normal" selected={@new_ticket_form.priority == "normal"}>Normal</option>
                  <option value="high" selected={@new_ticket_form.priority == "high"}>High</option>
                  <option value="urgent" selected={@new_ticket_form.priority == "urgent"}>Urgent</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                <textarea
                  id="message"
                  rows="4"
                  class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                  placeholder="Describe your issue in detail..."
                  phx-change="update_new_ticket_form"
                  phx-value-field="message"
                  phx-debounce="300"
                ><%= @new_ticket_form.message %></textarea>
              </div>

              <div class="flex justify-end space-x-3 pt-4">
                <button
                  type="button"
                  phx-click="hide_new_ticket_form"
                  class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled={@submitting || String.trim(@new_ticket_form.subject) == "" || String.trim(@new_ticket_form.message) == ""}
                >
                  <%= if @submitting, do: "Creating...", else: "Create Ticket" %>
                </button>
              </div>
            </form>
          </div>
        </div>
      <% end %>

      <!-- Tickets List -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <%= if Enum.empty?(@tickets) do %>
          <div class="text-center py-12">
            <div class="text-gray-400 mb-4">
              <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No Support Tickets</h3>
            <p class="text-gray-500 mb-4">Have a question or found a bug? Create a ticket to get help.</p>
            <button
              phx-click="show_new_ticket_form"
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
            >
              Create Your First Ticket
            </button>
          </div>
        <% else %>
          <div class="divide-y divide-gray-200">
            <%= for ticket <- @tickets do %>
              <.link navigate={~p"/support/#{ticket.id}"} class="block hover:bg-gray-50 transition-colors">
                <div class="p-6">
                  <div class="flex items-start justify-between">
                    <div class="flex items-start space-x-4">
                      <div class={"flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center bg-#{status_color(ticket.status)}-100"}>
                        <svg class={"w-5 h-5 text-#{status_color(ticket.status)}-600"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <%= case category_icon(ticket.category) do %>
                            <% "bug" -> %>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            <% "lightbulb" -> %>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                            <% "question-mark-circle" -> %>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            <% _ -> %>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                          <% end %>
                        </svg>
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center space-x-2">
                          <h3 class="text-sm font-medium text-gray-900 truncate"><%= ticket.subject %></h3>
                          <%= if Map.get(ticket, :unread_count, 0) > 0 do %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                              <%= ticket.unread_count %> new
                            </span>
                          <% end %>
                        </div>
                        <div class="mt-1 flex items-center space-x-4 text-sm text-gray-500">
                          <span class={"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-#{status_color(ticket.status)}-100 text-#{status_color(ticket.status)}-800"}>
                            <%= status_display(ticket.status) %>
                          </span>
                          <span><%= category_display(ticket.category) %></span>
                        </div>
                      </div>
                    </div>
                    <div class="flex-shrink-0 text-right">
                      <p class="text-sm text-gray-500">
                        <%= format_datetime(ticket.updated_at) %>
                      </p>
                      <svg class="w-5 h-5 text-gray-400 mt-2 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Back to Buttons -->
      <div class="mt-8 text-center">
        <a href={~p"/buttons"} class="text-blue-600 hover:text-blue-800 font-medium">
          ← Back to Buttons
        </a>
      </div>
    <% end %>
  </div>
</div>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
          <p class="text-gray-600 mt-2">Stay updated with your friends' activities</p>
        </div>
        <div class="flex items-center space-x-4">
          <div class="text-sm text-gray-500">
            <span class="font-medium text-blue-600"><%= @unread_count %></span> unread
          </div>
          <%= if @unread_count > 0 do %>
            <button phx-click="mark_all_read" 
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
              Mark All Read
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Notifications List -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <%= if Enum.empty?(@notifications) do %>
        <div class="text-center py-12">
          <div class="text-gray-400 mb-4">
            <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M15 17h5l-5 5v-5z"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications yet</h3>
          <p class="text-gray-500">Notifications will appear here when your friends interact with their buttons.</p>
        </div>
      <% else %>
        <div class="divide-y divide-gray-200">
          <%= for notification <- @notifications do %>
            <div class={[
              "p-6 transition-colors",
              if(notification.read, do: "bg-white", else: "bg-blue-50")
            ]}>
              <div class="flex items-start space-x-4">
                <!-- Notification Icon -->
                <div class={[
                  "flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center",
                  if(notification.read, do: "bg-gray-100", else: "bg-blue-100")
                ]}>
                  <%= case notification.notification_type do %>
                    <% "button_click" -> %>
                      <svg class={[
                        "w-5 h-5",
                        if(notification.read, do: "text-gray-600", else: "text-blue-600")
                      ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-5 5v-5z"/>
                      </svg>
                    <% "friend_request" -> %>
                      <svg class={[
                        "w-5 h-5",
                        if(notification.read, do: "text-gray-600", else: "text-blue-600")
                      ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    <% _ -> %>
                      <svg class={[
                        "w-5 h-5",
                        if(notification.read, do: "text-gray-600", else: "text-blue-600")
                      ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                  <% end %>
                </div>

                <!-- Notification Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between">
                    <h3 class={[
                      "text-sm font-medium",
                      if(notification.read, do: "text-gray-900", else: "text-blue-900")
                    ]}>
                      <%= notification.title %>
                    </h3>
                    <div class="flex items-center space-x-2">
                      <%= if not notification.read do %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          New
                        </span>
                      <% end %>
                      <span class="text-xs text-gray-500">
                        <span id={"notification-time-#{notification.id}"} phx-hook="LocalTime" data-utc={safe_to_iso8601(notification.inserted_at)}>
                          <%= Calendar.strftime(notification.inserted_at, "%m/%d %I:%M %p") %>
                        </span>
                      </span>
                    </div>
                  </div>

                  <p class={[
                    "text-sm mt-1",
                    if(notification.read, do: "text-gray-600", else: "text-blue-700")
                  ]}>
                    <%= notification.message %>
                  </p>
                </div>

                <!-- Actions -->
                <div class="flex-shrink-0">
                  <%= if not notification.read do %>
                    <button phx-click="mark_read"
                            phx-value-id={notification.id}
                            class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                      Mark Read
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Load More Button -->
        <%= if @has_more do %>
          <div class="p-6 text-center border-t border-gray-200">
            <button phx-click="load_more"
                    class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
              <%= if @loading_more do %>
                <span class="inline-flex items-center">
                  <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Loading...
                </span>
              <% else %>
                Load More
              <% end %>
            </button>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Back to Buttons -->
    <div class="mt-8 text-center">
      <a href={~p"/buttons"} class="text-blue-600 hover:text-blue-800 font-medium">
        ← Back to Buttons
      </a>
    </div>
  </div>
</div>



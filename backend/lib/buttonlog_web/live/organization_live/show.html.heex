<div class="min-h-screen bg-gray-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
    <div class="py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Back Link & Header -->
        <div class="mb-6">
          <a href={~p"/organizations"} class="text-purple-600 hover:text-purple-700 flex items-center gap-1 mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Organizations
          </a>

          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-purple-100 rounded-lg flex items-center justify-center">
                <%= if @organization.logo_url do %>
                  <img src={@organization.logo_url} alt={@organization.name} class="w-12 h-12 rounded" />
                <% else %>
                  <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                <% end %>
              </div>
              <div>
                <h1 class="text-2xl font-bold text-gray-900"><%= @organization.name %></h1>
                <%= if @organization.description do %>
                  <p class="text-gray-600"><%= @organization.description %></p>
                <% end %>
              </div>
            </div>

            <span class={"px-3 py-1 rounded-full text-sm font-medium #{role_badge_class(@my_role)}"}>
              <%= String.capitalize(@my_role || "member") %>
            </span>
          </div>
        </div>

        <!-- Subscription Status -->
        <%= if @subscription do %>
          <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Subscription</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div>
                <p class="text-sm text-gray-500">Status</p>
                <p class={"font-medium #{if @subscription.status == "active", do: "text-green-600", else: "text-red-600"}"}>
                  <%= String.capitalize(@subscription.status) %>
                </p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Billing Cycle</p>
                <p class="font-medium text-gray-900"><%= String.capitalize(@subscription.billing_cycle) %></p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Seats</p>
                <p class="font-medium text-gray-900">
                  <%= @subscription.seats_used %> / <%= @subscription.seats_purchased %> used
                </p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Period Ends</p>
                <p class="font-medium text-gray-900">
                  <%= if @subscription.current_period_end do %>
                    <%= Calendar.strftime(@subscription.current_period_end, "%b %d, %Y") %>
                  <% else %>
                    -
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Members Section -->
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">
              Members (<%= length(@organization.members) %>)
            </h2>
            <%= if @can_manage do %>
              <button
                phx-click="show_invite_modal"
                class="inline-flex items-center px-3 py-1.5 bg-purple-600 text-white text-sm rounded hover:bg-purple-700 transition-colors"
              >
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Invite Member
              </button>
            <% end %>
          </div>

          <div class="space-y-3">
            <%= for member <- @organization.members do %>
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                    <span class="text-gray-600 font-medium">
                      <%= String.first(member.user.display_name || member.user.username || "?") %>
                    </span>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">
                      <%= member.user.display_name || member.user.username %>
                    </p>
                    <span class={"px-2 py-0.5 rounded-full text-xs font-medium #{role_badge_class(member.role)}"}>
                      <%= String.capitalize(member.role) %>
                    </span>
                  </div>
                </div>

                <%= if @can_manage && member.role != "owner" && member.user_id != @current_user.id do %>
                  <div class="flex items-center gap-2">
                    <select
                      phx-change="update_member_role"
                      phx-value-user_id={member.user_id}
                      name="role"
                      class="text-sm border border-gray-300 rounded px-2 py-1"
                    >
                      <option value="member" selected={member.role == "member"}>Member</option>
                      <option value="admin" selected={member.role == "admin"}>Admin</option>
                      <option value="billing_admin" selected={member.role == "billing_admin"}>Billing Admin</option>
                    </select>
                    <button
                      phx-click="remove_member"
                      phx-value-user_id={member.user_id}
                      data-confirm="Are you sure you want to remove this member?"
                      class="text-red-600 hover:text-red-700"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Pending Invitations -->
          <%= if @can_manage && length(@invitations) > 0 do %>
            <div class="mt-6 pt-4 border-t border-gray-200">
              <h3 class="text-sm font-medium text-gray-700 mb-3">Pending Invitations</h3>
              <div class="space-y-2">
                <%= for invitation <- @invitations do %>
                  <div class="flex items-center justify-between p-2 bg-yellow-50 rounded-lg text-sm">
                    <div>
                      <span class="font-medium">
                        <%= if invitation.invitee do %>
                          <%= invitation.invitee.display_name || invitation.invitee.username %>
                        <% else %>
                          <%= invitation.email %>
                        <% end %>
                      </span>
                      <span class="text-gray-500 ml-2">as <%= invitation.role %></span>
                    </div>
                    <button
                      phx-click="cancel_invitation"
                      phx-value-id={invitation.id}
                      class="text-red-600 hover:text-red-700 text-sm"
                    >
                      Cancel
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Teams Section -->
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">
              Teams (<%= length(@teams) %>)
            </h2>
          </div>

          <%= if length(@teams) == 0 do %>
            <div class="text-center py-8">
              <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <p class="text-gray-500">No teams in this organization yet</p>
              <p class="text-gray-400 text-sm mt-1">Teams can be added from the Teams page</p>
            </div>
          <% else %>
            <div class="space-y-3">
              <%= for team <- @teams do %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-center gap-3">
                    <div
                      class="w-10 h-10 rounded-lg flex items-center justify-center"
                      style={"background-color: #{team.color || "#3B82F6"}20; border: 2px solid #{team.color || "#3B82F6"}"}
                    >
                      <svg class="w-5 h-5" style={"color: #{team.color || "#3B82F6"}"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="font-medium text-gray-900"><%= team.name %></p>
                      <p class="text-sm text-gray-500">
                        <%= length(team.members) %> members
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2">
                    <a
                      href={~p"/teams/#{team.id}"}
                      class="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors"
                    >
                      View
                    </a>
                    <%= if @can_manage do %>
                      <button
                        phx-click="remove_team"
                        phx-value-team_id={team.id}
                        data-confirm="Remove this team from the organization?"
                        class="text-red-600 hover:text-red-700"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Invite Member Modal -->
  <%= if @show_invite_modal do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-gray-900">Invite Member</h2>
            <button
              phx-click="hide_invite_modal"
              class="text-gray-400 hover:text-gray-600"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <p class="text-gray-600 text-sm mb-4">
            Invite a user to join this organization. They will receive a notification and can accept or decline.
          </p>

          <form phx-submit="invite_member" class="space-y-4">
            <div>
              <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
                Username
              </label>
              <input
                type="text"
                name="username"
                id="username"
                placeholder="Enter username"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              />
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-gray-700 mb-1">
                Role
              </label>
              <select
                name="role"
                id="role"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              >
                <option value="member">Member</option>
                <option value="admin">Admin</option>
                <option value="billing_admin">Billing Admin</option>
              </select>
              <p class="text-xs text-gray-500 mt-1">
                Admin: Can manage members and teams. Billing Admin: Can manage subscription.
              </p>
            </div>

            <div class="flex justify-end gap-3 pt-4">
              <button
                type="button"
                phx-click="hide_invite_modal"
                class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
              >
                Send Invitation
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% end %>
</div>

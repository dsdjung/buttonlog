<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @friend.display_name %></h1>
          <p class="text-gray-600">@<%= @friend.username %></p>
        </div>
        <div class="flex space-x-4">
          <a href={~p"/friends"} class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
            Back to Friends
          </a>
          <button phx-click="remove_friend"
                  class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors"
                  onclick="return confirm('Are you sure you want to remove this friend?')">
            Remove Friend
          </button>
        </div>
      </div>

      <!-- Flash Messages -->
      <%= if @flash[:info] do %>
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
          <%= @flash[:info] %>
        </div>
      <% end %>

      <%= if @flash[:error] do %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
          <%= @flash[:error] %>
        </div>
      <% end %>

      <!-- Friend Information -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Friend Information</h2>
        <div class="flex items-center space-x-6">
          <div class="w-24 h-24 bg-gray-300 rounded-full flex items-center justify-center flex-shrink-0" style="width: 96px; height: 96px; background-color: #d1d5db; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            <span class="text-gray-600 text-3xl font-medium uppercase" style="color: #4b5563; font-size: 1.875rem; font-weight: 500; text-transform: uppercase;"><%= String.first(@friend.display_name || "?") %></span>
          </div>

          <div class="flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p class="text-sm font-medium text-gray-500">Display Name</p>
                <p class="text-lg text-gray-900"><%= @friend.display_name %></p>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Username</p>
                <p class="text-lg text-gray-900">@<%= @friend.username %></p>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Member Since</p>
                <p class="text-lg text-gray-900">
                  <%= Calendar.strftime(@friend.inserted_at, "%B %Y") %>
                </p>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Friendship Status</p>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Friends
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Friend Permissions -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-semibold text-gray-900">Privacy Settings</h2>
          <p class="text-sm text-gray-500">Control what <%= @friend.display_name %> can see</p>
        </div>

        <div class="space-y-4">
          <!-- Can View History -->
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">View Activity History</p>
                <p class="text-sm text-gray-500">Allow this friend to see your button click history</p>
              </div>
            </div>
            <button
              phx-click="toggle_permission"
              phx-value-permission="can_view_history"
              class={"relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 #{if get_permission_value(@my_permissions, "can_view_history"), do: "bg-primary", else: "bg-gray-200"}"}
            >
              <span class={"pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out #{if get_permission_value(@my_permissions, "can_view_history"), do: "translate-x-5", else: "translate-x-0"}"}></span>
            </button>
          </div>

          <!-- Can View Buttons -->
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">View Buttons</p>
                <p class="text-sm text-gray-500">Allow this friend to see your buttons</p>
              </div>
            </div>
            <button
              phx-click="toggle_permission"
              phx-value-permission="can_view_buttons"
              class={"relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 #{if get_permission_value(@my_permissions, "can_view_buttons"), do: "bg-green-600", else: "bg-gray-200"}"}
            >
              <span class={"pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out #{if get_permission_value(@my_permissions, "can_view_buttons"), do: "translate-x-5", else: "translate-x-0"}"}></span>
            </button>
          </div>

          <!-- Can Receive Alerts -->
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Receive Alerts</p>
                <p class="text-sm text-gray-500">Send notifications to this friend when you click buttons</p>
              </div>
            </div>
            <button
              phx-click="toggle_permission"
              phx-value-permission="can_receive_alerts"
              class={"relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 #{if get_permission_value(@my_permissions, "can_receive_alerts"), do: "bg-yellow-500", else: "bg-gray-200"}"}
            >
              <span class={"pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out #{if get_permission_value(@my_permissions, "can_receive_alerts"), do: "translate-x-5", else: "translate-x-0"}"}></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Create Button for Friend -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-semibold text-gray-900">Create Button for <%= @friend.display_name %></h2>
        </div>

        <%= if @show_gift_button_form do %>
          <!-- Gift Button Form -->
          <div class="rounded-lg p-4 mb-4" style="background-color: #F3E8FF; border: 1px solid #C084FC;">
            <div class="flex items-center space-x-2 mb-2">
              <svg class="w-5 h-5" style="color: #9333EA;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
              <span class="font-medium" style="color: #7E22CE;">Gift Button</span>
            </div>
            <p class="text-sm" style="color: #9333EA;">
              This button will appear in <%= @friend.display_name %>'s button list. You'll be notified when they use it.
            </p>
          </div>

          <div class="space-y-4">
            <!-- Button Name -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Button Name *</label>
              <input type="text"
                     value={@gift_button_name}
                     phx-blur="update_gift_button_field"
                     phx-value-field="name"
                     phx-keyup="update_gift_button_field"
                     phx-value-field="name"
                     class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                     placeholder="e.g., Morning Routine, Take Vitamin" />
            </div>

            <!-- Button Type -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Button Type</label>
              <div class="grid grid-cols-4 gap-2">
                <button type="button"
                        phx-click="select_button_type"
                        phx-value-type="instant"
                        class="px-3 py-2 rounded-lg border text-sm font-medium transition-colors"
                        style={"#{if @gift_button_type == "instant", do: "background-color: #9333EA; color: white; border-color: #9333EA;", else: "background-color: white; color: #374151; border-color: #D1D5DB;"}"}>
                  ⚡ Instant
                </button>
                <button type="button"
                        phx-click="select_button_type"
                        phx-value-type="toggle"
                        class="px-3 py-2 rounded-lg border text-sm font-medium transition-colors"
                        style={"#{if @gift_button_type == "toggle", do: "background-color: #9333EA; color: white; border-color: #9333EA;", else: "background-color: white; color: #374151; border-color: #D1D5DB;"}"}>
                  🔄 Toggle
                </button>
                <button type="button"
                        phx-click="select_button_type"
                        phx-value-type="one-time"
                        class="px-3 py-2 rounded-lg border text-sm font-medium transition-colors"
                        style={"#{if @gift_button_type == "one-time", do: "background-color: #9333EA; color: white; border-color: #9333EA;", else: "background-color: white; color: #374151; border-color: #D1D5DB;"}"}>
                  1️⃣ One-Time
                </button>
                <button type="button"
                        phx-click="select_button_type"
                        phx-value-type="workflow"
                        class="px-3 py-2 rounded-lg border text-sm font-medium transition-colors"
                        style={"#{if @gift_button_type == "workflow", do: "background-color: #9333EA; color: white; border-color: #9333EA;", else: "background-color: white; color: #374151; border-color: #D1D5DB;"}"}>
                  📋 Workflow
                </button>
              </div>
            </div>

            <!-- Choices (only for one-time buttons) -->
            <%= if @gift_button_type == "one-time" do %>
              <div id="gift-choices-section" phx-update="ignore">
                <div x-data={"{ choices: #{Jason.encode!(@gift_button_choices || ["", ""])} }"}
                     x-effect="document.getElementById('gift-choices-hidden').value = JSON.stringify(choices)">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Choices (Optional)</label>
                  <p class="text-xs text-gray-500 mb-2">Add 2 or more choices to create a multiple choice button</p>
                  <div class="space-y-2">
                    <template x-for="(choice, index) in choices" x-bind:key="index">
                      <div class="flex items-center space-x-2">
                        <input type="text"
                               x-model="choices[index]"
                               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                               x-bind:placeholder="'Choice ' + (index + 1)" />
                        <button type="button"
                                x-show="choices.length > 2"
                                x-on:click="choices.splice(index, 1)"
                                class="p-2 text-red-500 hover:text-red-700 transition-colors">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </div>
                    </template>
                    <button type="button"
                            x-show="choices.length < 10"
                            x-on:click="choices.push('')"
                            class="flex items-center space-x-1 text-sm text-purple-600 hover:text-purple-800 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                      </svg>
                      <span>Add Choice</span>
                    </button>
                  </div>
                </div>
              </div>
              <input type="hidden"
                     id="gift-choices-hidden"
                     name="choices_json"
                     value={Jason.encode!(@gift_button_choices || ["", ""])} />
            <% end %>

            <!-- Button Color -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Color</label>
              <div class="flex space-x-2">
                <%= for color <- ["#00BFA5", "#34C759", "#FF3B30", "#FF9500", "#AF52DE", "#FF2D55", "#5856D6", "#007AFF"] do %>
                  <button type="button"
                          phx-click="update_gift_button_field"
                          phx-value-field="color"
                          phx-value-value={color}
                          class={"w-8 h-8 rounded-full border-2 transition-transform hover:scale-110 #{if @gift_button_color == color, do: "border-gray-800 ring-2 ring-offset-2 ring-gray-400", else: "border-transparent"}"}
                          style={"background-color: #{color}"}>
                  </button>
                <% end %>
              </div>
            </div>

            <!-- Gift Message -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Gift Message (optional)</label>
              <textarea
                     phx-blur="update_gift_button_field"
                     phx-value-field="message"
                     phx-keyup="update_gift_button_field"
                     phx-value-field="message"
                     class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                     rows="2"
                     placeholder="Add a personal message for your friend..."><%= @gift_button_message %></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-end space-x-3 pt-4">
              <button type="button"
                      phx-click="hide_gift_button_form"
                      class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                Cancel
              </button>
              <button type="button"
                      id="create-gift-button"
                      phx-click="create_gift_button"
                      phx-hook="GiftButtonChoices"
                      disabled={@gift_button_name == ""}
                      class="px-4 py-2 rounded-lg transition-colors"
                      style={"color: white; #{if @gift_button_name == "", do: "background-color: #C4B5FD; cursor: not-allowed;", else: "background-color: #9333EA;"}"}>
                <span class="flex items-center space-x-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
                  </svg>
                  <span>Create Gift Button</span>
                </span>
              </button>
            </div>
          </div>
        <% else %>
          <!-- Show Create Button -->
          <div class="text-center py-4">
            <p class="text-gray-600 mb-4">Create a button that will appear in <%= @friend.display_name %>'s button list. You'll be notified when they use it.</p>
            <button phx-click="show_gift_button_form"
                    class="inline-flex items-center px-4 py-2 rounded-lg transition-colors"
                    style="background-color: #9333EA; color: white;">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
              Create Button for <%= @friend.display_name %>
            </button>
          </div>
        <% end %>
      </div>

      <!-- Buttons I Created for This Friend -->
      <%= if length(@gift_buttons) > 0 do %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Buttons You Created for <%= @friend.display_name %></h2>
          <div class="space-y-3">
            <%= for button <- @gift_buttons do %>
              <div class={"p-4 border rounded-lg #{if button.archived, do: "border-gray-300 bg-gray-50", else: "border-purple-200 bg-purple-50"}"}>
                <div class="flex items-center space-x-4">
                  <div class="w-12 h-12 rounded-full flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
                       style={"background-color: #{button.color || "#9333EA"}; #{if button.archived, do: "opacity: 0.5;", else: ""}"}>
                    <%= case button.type do %>
                      <% "instant" -> %>⚡
                      <% "toggle" -> %>🔄
                      <% "one-time" -> %>1️⃣
                      <% "workflow" -> %>📋
                      <% _ -> %>📱
                    <% end %>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center space-x-2">
                      <h3 class={"font-semibold #{if button.archived, do: "text-gray-500", else: "text-gray-900"}"}><%= button.name %></h3>
                      <%= if button.archived do %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-600">
                          Archived
                        </span>
                      <% end %>
                    </div>
                    <p class="text-sm text-gray-500">
                      <%= case button.type do %>
                        <% "instant" -> %>Instant
                        <% "toggle" -> %>Toggle
                        <% "one-time" -> %>One-Time
                        <% "workflow" -> %>Workflow
                        <% _ -> %>Button
                      <% end %>
                      <span class="mx-1">•</span>
                      Created <%= Calendar.strftime(button.inserted_at, "%b %d, %Y") %>
                    </p>
                    <%= if button.latest_click_at do %>
                      <p class="text-sm text-green-600 mt-1">
                        Last used: <%= Calendar.strftime(button.latest_click_at, "%m/%d %I:%M %p") %>
                      </p>
                    <% else %>
                      <p class="text-sm text-gray-400 mt-1">Not used yet</p>
                    <% end %>
                    <%= if button.gift_message do %>
                      <p class="text-sm text-purple-600 mt-2 italic">"<%= button.gift_message %>"</p>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Shared Activity -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Shared Buttons -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Shared Buttons</h2>
          <%= if length(@shared_buttons) > 0 do %>
            <div class="space-y-3">
              <%= for button <- @shared_buttons do %>
                <div class="p-3 border border-gray-200 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-lg font-bold flex-shrink-0"
                         style={"background-color: #{button.color || "#00BFA5"}"}>
                      <%= case button.type do %>
                        <% "instant" -> %>⚡
                        <% "toggle" -> %>🔄
                        <% "one-time" -> %>1️⃣
                        <% "workflow" -> %>📋
                        <% _ -> %>📱
                      <% end %>
                    </div>
                    <div class="flex-1">
                      <h3 class="font-medium text-gray-900"><%= button.name %></h3>
                      <p class="text-sm text-gray-500">
                        <%= if button.latest_click_at do %>
                          Last clicked <%= Calendar.strftime(button.latest_click_at, "%m/%d %I:%M %p") %>
                        <% else %>
                          Never clicked
                        <% end %>
                      </p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="text-gray-400 mb-4">
                <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No shared buttons</h3>
              <p class="text-gray-500">This friend hasn't shared any buttons with you yet</p>
            </div>
          <% end %>
        </div>

        <!-- Shared Alerts -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Shared Alerts</h2>
          <%= if length(@shared_notifications) > 0 do %>
            <div class="space-y-3">
              <%= for notification <- @shared_notifications do %>
                <div class="p-3 border border-gray-200 rounded-lg">
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-5 5v-5z"/>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <p class="text-sm text-gray-900"><%= notification.message %></p>
                      <p class="text-xs text-gray-500">
                        <%= Calendar.strftime(notification.inserted_at, "%m/%d %I:%M %p") %>
                      </p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="text-gray-400 mb-4">
                <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 17h5l-5 5v-5z"/>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No shared notifications</h3>
              <p class="text-gray-500">No notifications have been shared with this friend yet</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Activity History Section -->
      <div class="mt-8">
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Activity History</h2>
          <%= if @can_view_history do %>
            <%= if length(@friend_activity) > 0 do %>
              <div class="space-y-3">
                <%= for activity <- @friend_activity do %>
                  <div class="p-3 border border-gray-200 rounded-lg">
                    <div class="flex items-center space-x-3">
                      <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-lg font-bold flex-shrink-0"
                           style={"background-color: #{activity.button_color || "#00BFA5"}"}>
                        <%= case activity.button_type do %>
                          <% "instant" -> %>⚡
                          <% "timed" -> %>⏱️
                          <% "state" -> %>🔄
                          <% _ -> %>📱
                        <% end %>
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center justify-between">
                          <h3 class="font-medium text-gray-900"><%= activity.button_name %></h3>
                          <span class={"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium #{cond do activity.action == "start" -> "bg-green-100 text-green-800"; activity.action == "end" -> "bg-red-100 text-red-800"; true -> "bg-blue-100 text-blue-800" end}"}>
                            <%= activity.action || "click" %>
                          </span>
                        </div>
                        <p class="text-sm text-gray-500">
                          <%= Calendar.strftime(activity.clicked_at, "%m/%d/%Y %I:%M %p") %>
                          <%= if activity.duration do %>
                            <span class="ml-2 text-gray-400">(<%= activity.duration %>s)</span>
                          <% end %>
                        </p>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-8">
                <div class="text-gray-400 mb-4">
                  <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No activity yet</h3>
                <p class="text-gray-500">This friend hasn't recorded any button activity yet</p>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-8">
              <div class="text-gray-400 mb-4">
                <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-2">Activity History Private</h3>
              <p class="text-gray-500">This friend has not granted you permission to view their activity history</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

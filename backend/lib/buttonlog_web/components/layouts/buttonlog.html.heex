<header class="bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo and Brand -->
      <div class="flex items-center">
        <a href="/" class="flex items-center">
          <img src={~p"/images/logo.png"} alt="ButtonLog Logo" class="h-8 w-auto" />
        </a>
      </div>

      <!-- Navigation -->
      <nav class="flex items-center space-x-8">
        <a href={~p"/diary"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
          Diary
        </a>
        <a href={~p"/friends"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
          Friends
        </a>
        <a href={~p"/teams"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
          Teams
        </a>
        <a href={~p"/organizations"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
          Organizations
        </a>
        <a href={~p"/notifications"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
          Alerts
        </a>
      </nav>

      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        <%= if @current_user do %>
          <a href={~p"/account"} class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 transition-colors" title="Account Settings">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </a>
        <% else %>
          <a href={~p"/auth/login"} class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">
            Login
          </a>
          <a href={~p"/auth/register"} class="bg-blue-600 text-white hover:bg-blue-700 px-4 py-2 rounded-md text-sm font-medium transition-colors">
            Register
          </a>
        <% end %>
      </div>
    </div>
  </div>
</header>

<main class="flex-1">
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>
